# Dormant native zero-entry proof. Requires fresh native-cold admission and guard.
[Unit]
Description=Horizon epoch 227 original-runtime cold input verification

[Service]
Type=exec
User=ubuntu
Group=ubuntu
Restart=no
KillMode=control-group
Delegate=no
RuntimeMaxSec=2700
TimeoutStopSec=60
MemoryHigh=112G
MemoryMax=128G
MemorySwapMax=0
TasksMax=512
CPUAffinity=0-7
CPUQuota=800%
Nice=10
IOWeight=10
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/home/ubuntu/.jetstreamer-private/native-input227-v1620-capped-v1
Environment=RUST_MIN_STACK=67108864
Environment=SOLANA_RAYON_THREADS=8
Environment=JETSTREAMER_HISTORICAL_POH_THREADS=2
Environment=JETSTREAMER_EPOCH227_V1620_TEST_SCRATCH=/home/ubuntu/.jetstreamer-private/native-input227-v1620-capped-v1/scratch
ExecStart=/var/lib/jetstreamer/horizon-227-native-test-optimized-v1/native-input-test runtime::tests::native_epoch227_cold_input_matches_canonical_accounts_commitment --exact --ignored --test-threads=1 --nocapture
