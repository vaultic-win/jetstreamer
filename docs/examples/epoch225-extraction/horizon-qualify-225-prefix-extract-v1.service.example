[Unit]
Description=Private epoch 225 prefix extraction; epoch 226 debt retained

[Service]
Type=exec
User=root
Group=root
UMask=0077
WorkingDirectory=/var/lib/jetstreamer
ExecStart=/var/lib/jetstreamer/horizon-epoch225-extractor-ACTUAL/jetstreamer-epoch225-prefix-extract /var/lib/jetstreamer/horizon-epoch225-extract-inputs-v1/plan.json --plan-sha256 ACTUAL_SEALED_PLAN_SHA256 --self-sha256 ACTUAL_QUALIFIED_EXTRACTOR_SHA256
MemoryHigh=72G
MemoryMax=96G
MemorySwapMax=0
CPUQuota=800%
CPUQuotaPeriodSec=100ms
TasksMax=512
RuntimeMaxSec=86400
Restart=no
KillMode=control-group
Delegate=no
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.jetstreamer-private/epoch225-prefix-extract-v1
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
Environment=RUST_LOG=info
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV PYTHONPATH PYTHONHOME RUBYOPT PERL5OPT GCONV_PATH
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
