# SOURCE TEMPLATE ONLY. Root controller must render/seal exact plan and artifact bindings.
# Existing native211/251/265 guard images do not support this harness+worker profile.
[Unit]
Description=Epoch 257 exact selected-worker cold input qualification
[Service]
Type=exec
User=ubuntu
Group=ubuntu
UMask=0077
Restart=no
KillMode=control-group
Delegate=no
MemoryHigh=100000000000
MemoryMax=120000000000
MemorySwapMax=0
TasksMax=512
CPUQuota=800%
CPUAffinity=@EIGHT_REVIEWED_CPUS@
RuntimeMaxSec=2700
TimeoutStopSec=30
OOMPolicy=kill
OOMScoreAdjust=1000
ProtectHome=read-only
ProtectSystem=strict
ProtectControlGroups=yes
PrivateNetwork=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/home/ubuntu/.jetstreamer-private/native-input257-selected-20261120-v1
WorkingDirectory=/home/ubuntu/.jetstreamer-private/native-input257-selected-20261120-v1
Environment=RUST_MIN_STACK=134217728 SOLANA_RAYON_THREADS=8 JETSTREAMER_HISTORICAL_POH_THREADS=2
Environment=JETSTREAMER_EPOCH257_STARTUP_PLAN=@SEALED_PLAN_PATH@
Environment=JETSTREAMER_EPOCH257_STARTUP_PLAN_SHA256=@SEALED_PLAN_SHA256@
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
ExecStart=@SEALED_HARNESS_PATH@
