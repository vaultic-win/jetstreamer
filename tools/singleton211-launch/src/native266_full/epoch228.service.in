[Unit]
Description=Private guarded epoch 228 full-window replay
[Service]
Type=exec
User=ubuntu
Group=ubuntu
UMask=0077
Restart=no
KillMode=control-group
Delegate=no
MemoryHigh=100000000000
MemoryMax=@MEMORY@
MemorySwapMax=0
CPUQuota=800%
AllowedCPUs=@CPUS@
CPUAffinity=@CPUS@
TasksMax=512
RuntimeMaxSec=259200
TimeoutStopSec=180
TimeoutStartSec=180
LimitFSIZE=274877906944
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
OOMPolicy=kill
OOMScoreAdjust=1000
StandardOutput=journal
StandardError=journal
WorkingDirectory=@ROOT@
ReadWritePaths=@ROOT@
BindReadOnlyPaths=/var/lib/jetstreamer/horizon-stage227-bootstrap-dcaafc6-v1/genesis.tar.bz2:@ROOT@/ledger/genesis.tar.bz2
UnsetEnvironment=HORIZON_S3_ENDPOINT HORIZON_ACCESS_KEY_ID HORIZON_SECRET_ACCESS_KEY AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN JETSTREAMER_ROOT_COHORT_RESUME_RUN JETSTREAMER_EXPORT_HANDOFF_SNAPSHOT_DIR JETSTREAMER_LOAD_FROM_DIR JETSTREAMER_ADAPTIVE_EPOCH_CONCURRENCY JETSTREAMER_ARCHIVE_BASE
Environment=JETSTREAMER_HISTORICAL_WORKER_EPOCH228_DEMOTION=/var/lib/jetstreamer/horizon228-demotion-bank-9d2fd8d4-v158-v2-qualified/worker
Environment=JETSTREAMER_PRIVATE_RUN_ROOT=@ROOT@/state
Environment=JETSTREAMER_NETWORK=mainnet
Environment=JETSTREAMER_ARCHIVE_BACKEND=http
Environment=JETSTREAMER_COMPACT_INDEX_BASE_URL=https://files.old-faithful.net/
Environment=JETSTREAMER_HTTP_BASE_URL=https://files.old-faithful.net/
Environment=JETSTREAMER_ALLOW_CANDIDATE_RUNTIME=1
Environment=JETSTREAMER_CLEAR_ACCOUNTS_ON_START=1
Environment=JETSTREAMER_ENFORCE_ARCHIVE_HASH=1
Environment=JETSTREAMER_VERIFY_SNAPSHOTS=1
Environment=JETSTREAMER_SKIP_SNAPSHOT_VERIFY=0
Environment=JETSTREAMER_PRUNE_EPOCH_SNAPSHOTS=0
Environment=JETSTREAMER_RIPGET_THREADS=1
Environment=JETSTREAMER_REPLAY_THREADS=8
Environment=JETSTREAMER_HISTORICAL_POH_THREADS=8
Environment=SOLANA_RAYON_THREADS=8
Environment=RAYON_NUM_THREADS=8
Environment=TOKIO_WORKER_THREADS=8
Environment=RUST_MIN_STACK=134217728
Environment=RUST_LOG=info
Environment=TMPDIR=@ROOT@/tmp
Environment=CLOUDSDK_CONFIG=@ROOT@/tmp/isolated-empty-gcloud
Environment=CLOUDSDK_CORE_DISABLE_PROMPTS=1
Environment=CLOUDSDK_CORE_DISABLE_FILE_LOGGING=1
Environment=PATH=/home/linuxbrew/.linuxbrew/share/google-cloud-sdk/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ReadOnlyPaths=@STATE@/spec.json
BindPaths=@ROOT@/tmp:/tmp @ROOT@/var-tmp:/var/tmp
InaccessiblePaths=-/dev/shm -/home/ubuntu/.aws -/home/ubuntu/.config/gcloud -/root/.aws
Environment=AWS_EC2_METADATA_DISABLED=true
UnsetEnvironment=GOOGLE_APPLICATION_CREDENTIALS AWS_PROFILE
ExecStart=@IMAGE@ epoch228-full wait @MODE@ @STATE@/spec.json @SPEC@
