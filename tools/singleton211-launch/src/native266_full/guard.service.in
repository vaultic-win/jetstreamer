[Unit]
@FAILURE@
Description=Epoch 266 private replay protective guard
[Service]
Type=oneshot
User=root
UMask=0077
Restart=no
MemoryMax=1073741824
MemorySwapMax=0
CPUQuota=100%
TasksMax=256
TimeoutStartSec=220
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_SYS_PTRACE
ReadWritePaths=@STATE@/receipts
EnvironmentFile=@STATE@/guard.env
ExecStart=@IMAGE@ epoch266-full @ROLE@ @MODE@ @STATE@/supervisor.json ${HORIZON266_SUPERVISOR_SHA}
