[Unit]
Description=Exercise the exact epoch 257 guard and held harness inside a private PID1
DefaultDependencies=no
Requires=systemd-journald.service
After=systemd-journald.service
SuccessAction=exit-force
FailureAction=exit-force
[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=90
ExecStart=/fixture/sandbox-tests native257::stop_sandbox::exact_guard_terminates_a_held_owner_without_a_release_token --exact --ignored --nocapture --test-threads=1
Environment=RUST_BACKTRACE=1
StandardOutput=append:/evidence/driver.stdout
StandardError=append:/evidence/driver.stderr
ExecStartPre=/bin/sh /fixture/preflight
ExecStopPost=/bin/sh /fixture/postflight
