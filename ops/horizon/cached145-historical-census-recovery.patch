+fn unavailable_host_endpoint(host: &Value) -> Result<()> {
+    let object = host
+        .as_object()
+        .context("historical unavailable host object")?;
+    ensure!(
+        object.len() == 4
+            && [
+                "status",
+                "error",
+                "census_attempts",
+                "discarded_attempt_errors"
+            ]
+            .iter()
+            .all(|key| object.contains_key(*key)),
+        "historical unavailable endpoint carries unexpected evidence or authority"
+    );
+    ensure!(
+        host["status"] == "unavailable"
+            && host["error"]
+                .as_str()
+                .is_some_and(|s| !s.is_empty() && s.len() <= 4096),
+        "historical census failure must remain explicit"
+    );
+    let attempts = number(host, "census_attempts")?;
+    let errors = host["discarded_attempt_errors"]
+        .as_array()
+        .context("historical census failure history")?;
+    ensure!(
+        (1..=5).contains(&attempts)
+            && errors.len() as u64 == attempts
+            && errors.last() == Some(&host["error"])
+            && errors
+                .iter()
+                .all(|v| v.as_str().is_some_and(|s| !s.is_empty() && s.len() <= 4096)),
+        "historical census failure is incomplete or unbounded"
+    );
+    Ok(())
+}
