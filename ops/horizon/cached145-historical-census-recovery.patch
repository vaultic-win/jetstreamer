+pub fn comparison(
+    transition: Option<&Value>,
+    sources: &BTreeMap<String, Value>,
+    expected: &Value,
+    actual: &Value,
+) -> Result<Option<Value>> {
+    let Some(t) = transition.filter(|t| !t[FIELD].is_null()) else {
+        return Ok(None);
+    };
+    descriptor_matches(&t[FIELD])?;
+    if expected["Id"] != TIMER {
+        return Ok(None);
+    }
+    // Selecting the post-reload descriptor commits every CURRENT native cut to the genuine zero display.
+    // An old original display at one cut must not slip through an equality fast path.
+    validate(&t[FIELD], sources)?;
+    original_timer(actual, ZERO)?;
+    if expected["TimersMonotonic"] == actual["TimersMonotonic"] {
+        return Ok(None);
+    }
+    ensure!(
+        expected["TimersMonotonic"] == ORIGINAL && actual["TimersMonotonic"] == ZERO,
+        "inactive timer display transition is not the exact one-way original-to-zero change"
+    );
+    let mut result = actual.clone();
+    result["TimersMonotonic"] = expected["TimersMonotonic"].clone();
+    Ok(Some(result))
+}
