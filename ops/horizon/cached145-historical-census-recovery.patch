--- a/helper-source/jetstreamer-r2/src/fleet/cached145_terminal_observer_tests.rs
+++ b/helper-source/jetstreamer-r2/src/fleet/cached145_terminal_observer_tests.rs
@@ -276,0 +277,74 @@
+
+fn historical_gap_fixture(name: &str) -> Value {
+    serde_json::from_str(match name {
+        "previous" => include_str!("historical_census_gap_fixtures/previous0328.json"),
+        "historical" => include_str!("historical_census_gap_fixtures/sample0358.json"),
+        "current" => include_str!("historical_census_gap_fixtures/sample0428.json"),
+        _ => panic!("unknown gap fixture"),
+    })
+    .unwrap()
+}
+#[test]
+fn historical_single_endpoint_gap_retains_terminal_and_never_passes_default_gate() {
+    let previous = historical_gap_fixture("previous");
+    let historical = historical_gap_fixture("historical");
+    let current = historical_gap_fixture("current");
+    let w = witness();
+    assert!(w.unavailable(&identity(), &historical, &clock).is_err());
+    assert_eq!(
+        w.historical_unavailable(&identity(), &historical, &current, &previous, &clock)
+            .unwrap(),
+        Phase::OriginalCompleted
+    );
+    assert_eq!(
+        historical["host_resident_memory"]["before"]["status"],
+        "unavailable"
+    );
+    assert!(
+        historical["host_resident_memory"]["before"]
+            .get("rss")
+            .is_none()
+    );
+}
+#[test]
+fn historical_gap_rejects_current_failure_credit_revival_malformed_and_reordered_evidence() {
+    for mode in 0..12 {
+        let mut previous = historical_gap_fixture("previous");
+        let mut historical = historical_gap_fixture("historical");
+        let mut current = historical_gap_fixture("current");
+        match mode {
+            0 => {
+                current["host_resident_memory"]["before"] =
+                    historical["host_resident_memory"]["before"].clone()
+            }
+            1 => {
+                historical["host_resident_memory"]["after"] =
+                    historical["host_resident_memory"]["before"].clone()
+            }
+            2 => historical["host_resident_memory"]["before"]["admission_authorized"] = json!(true),
+            3 => {
+                historical["host_resident_memory"]["before"]["rss"] =
+                    json!({"aggregate_rss_bytes":0})
+            }
+            4 => historical["host_resident_memory"]["before"]["census_attempts"] = json!(6),
+            5 => {
+                historical["host_resident_memory"]["before"]["discarded_attempt_errors"] = json!([])
+            }
+            6 => historical["recorded_at_utc"] = current["recorded_at_utc"].clone(),
+            7 => {
+                previous["diagnostics"][0]["cached145_resource_promise"]["memory_or_DATA_credit_bytes"] =
+                    json!(1)
+            }
+            8 => previous["unit_census"][UNIT]["MainPID"] = json!("965009"),
+            9 => historical["replays"] = json!([{"claimed":true}]),
+            10 => current["replays"] = json!([{"claimed":true}]),
+            _ => historical["host_resident_memory"]["after"]["rss"]["census_stable"] = json!(false),
+        }
+        assert!(
+            witness()
+                .historical_unavailable(&identity(), &historical, &current, &previous, &clock)
+                .is_err(),
+            "mode {mode}"
+        );
+    }
+}
