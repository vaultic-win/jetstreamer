+    /// A historical, non-authorizing gap can retain an already completed owner.
+    /// The accepted predecessor proves the exact original terminal and retains
+    /// every resource promise; the current sample still needs both full censuses.
+    /// No current sample, live owner, verification phase, or resource credit uses
+    /// this route. The caller still authenticates all raw links and exact cadence.
+    pub fn historical_unavailable(
+        &self,
+        identity: &Identity<'_>,
+        sample: &Value,
+        current: &Value,
+        predecessor: &Value,
+        clock: &impl Fn(&str) -> Result<u64>,
+    ) -> Result<Phase> {
+        self.predecessor(predecessor, clock)?;
+        ensure!(
+            self.unavailable(identity, current, clock)? == Phase::OriginalCompleted,
+            "historical census gap requires a fully observed current terminal"
+        );
+        let prior = seconds(predecessor, "sampled_at_utc", clock)?;
+        let at = seconds(sample, "recorded_at_utc", clock)?;
+        let end = seconds(sample, "completed_at_utc", clock)?;
+        let now = seconds(current, "recorded_at_utc", clock)?;
+        ensure!(
+            prior < at && at <= end && end < now,
+            "historical census gap is not strictly between accepted predecessor and current"
+        );
+        ensure!(
+            sample["replays"].as_array().is_some_and(Vec::is_empty)
+                && current["replays"].as_array().is_some_and(Vec::is_empty),
+            "historical census gap cannot cover an executing replay"
+        );
+        let missing = ["before", "after"]
+            .into_iter()
+            .filter(|end| sample["host_resident_memory"][*end]["status"] == "unavailable")
+            .count();
+        ensure!(
+            missing == 1,
+            "historical census gap requires exactly one unavailable endpoint"
+        );
+        self.unavailable_selected(identity, sample, clock, true)
+    }
+
