@@ -299,0 +300,52 @@
+        self.unavailable_selected(identity, sample, clock, false)
+    }
+
+    /// A historical, non-authorizing gap can retain an already completed owner.
+    /// The accepted predecessor proves the exact original terminal and retains
+    /// every resource promise; the current sample still needs both full censuses.
+    /// No current sample, live owner, verification phase, or resource credit uses
+    /// this route. The caller still authenticates all raw links and exact cadence.
+    pub fn historical_unavailable(
+        &self,
+        identity: &Identity<'_>,
+        sample: &Value,
+        current: &Value,
+        predecessor: &Value,
+        clock: &impl Fn(&str) -> Result<u64>,
+    ) -> Result<Phase> {
+        self.predecessor(predecessor, clock)?;
+        ensure!(
+            self.unavailable(identity, current, clock)? == Phase::OriginalCompleted,
+            "historical census gap requires a fully observed current terminal"
+        );
+        let prior = seconds(predecessor, "sampled_at_utc", clock)?;
+        let at = seconds(sample, "recorded_at_utc", clock)?;
+        let end = seconds(sample, "completed_at_utc", clock)?;
+        let now = seconds(current, "recorded_at_utc", clock)?;
+        ensure!(
+            prior < at && at <= end && end < now,
+            "historical census gap is not strictly between accepted predecessor and current"
+        );
+        ensure!(
+            sample["replays"].as_array().is_some_and(Vec::is_empty)
+                && current["replays"].as_array().is_some_and(Vec::is_empty),
+            "historical census gap cannot cover an executing replay"
+        );
+        let missing = ["before", "after"]
+            .into_iter()
+            .filter(|end| sample["host_resident_memory"][*end]["status"] == "unavailable")
+            .count();
+        ensure!(
+            missing == 1,
+            "historical census gap requires exactly one unavailable endpoint"
+        );
+        self.unavailable_selected(identity, sample, clock, true)
+    }
+
+    fn unavailable_selected(
+        &self,
+        identity: &Identity<'_>,
+        sample: &Value,
+        clock: &impl Fn(&str) -> Result<u64>,
+        historical_gap: bool,
+    ) -> Result<Phase> {
@@ -372 +424,10 @@
-            host_identity(sample, end, phase == Phase::ParentVerification)?;
+            let host = &sample["host_resident_memory"][end];
+            if historical_gap && host["status"] == "unavailable" {
+                ensure!(
+                    phase == Phase::OriginalCompleted,
+                    "historical census gap cannot establish parent verification"
+                );
+                unavailable_host_endpoint(host)?;
+            } else {
+                host_identity(sample, end, phase == Phase::ParentVerification)?;
+            }
@@ -376,0 +438,39 @@
+fn unavailable_host_endpoint(host: &Value) -> Result<()> {
+    let object = host
+        .as_object()
+        .context("historical unavailable host object")?;
+    ensure!(
+        object.len() == 4
+            && [
+                "status",
+                "error",
+                "census_attempts",
+                "discarded_attempt_errors"
+            ]
+            .iter()
+            .all(|key| object.contains_key(*key)),
+        "historical unavailable endpoint carries unexpected evidence or authority"
+    );
+    ensure!(
+        host["status"] == "unavailable"
+            && host["error"]
+                .as_str()
+                .is_some_and(|s| !s.is_empty() && s.len() <= 4096),
+        "historical census failure must remain explicit"
+    );
+    let attempts = number(host, "census_attempts")?;
+    let errors = host["discarded_attempt_errors"]
+        .as_array()
+        .context("historical census failure history")?;
+    ensure!(
+        (1..=5).contains(&attempts)
+            && errors.len() as u64 == attempts
+            && errors.last() == Some(&host["error"])
+            && errors
+                .iter()
+                .all(|v| v.as_str().is_some_and(|s| !s.is_empty() && s.len() <= 4096)),
+        "historical census failure is incomplete or unbounded"
+    );
+    Ok(())
+}
