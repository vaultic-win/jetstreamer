+//! Genuine immediate predecessor image with native and seal provenance; no new authority.
+use super::*;
+fn fixture(raw: &[u8], digest: &str) -> Value {
+    assert_eq!(format!("{:x}", Sha256::digest(raw)), digest);
+    serde_json::from_slice(raw).unwrap()
+}
+fn previous() -> Value {
+    fixture(
+        include_bytes!("accepted-sealed-alias-fixtures/frame.json"),
+        "fa5a8a0dece45f9cbc79488a3785ae6f1356f01c2f3abf07d767e9332fb2805b",
+    )
+}
+#[test]
+fn actual_sealed_alias_predecessor_has_native_success_and_exact_normal_seal() {
+    let frame = previous();
+    let acceptance = fixture(
+        include_bytes!("accepted-sealed-alias-fixtures/acceptance.json"),
+        "17f93aede8cffbeae228707ac2b55d926c326d1f5ca09caca5cc7f3281633cad",
+    );
+    let selector = fixture(
+        include_bytes!("accepted-sealed-alias-fixtures/selector.json"),
+        "3d8fee56a3cd520096c090a5f4718654376925964f6b3803176001b8160f86e8",
+    );
+    let seal = fixture(
+        include_bytes!("accepted-sealed-alias-fixtures/seal.json"),
+        "b86481f7d8c71208746d594264b16be28db440fd25f84df75ea0cc81685b13d6",
+    );
+    let proof = fixture(
+        include_bytes!("accepted-sealed-alias-fixtures/proof.json"),
+        "49b03cade0a2bee6649a868c0c28790067d8048402ca9b29d815d099a9d90d80",
+    );
+    assert_eq!(
+        frame["self_sha256"],
+        QUALIFIED_SEALED_ALIAS_FRAME_CAPTURE_SHA
+    );
+    assert_eq!(
+        acceptance["frame"]["sha256"],
+        "fa5a8a0dece45f9cbc79488a3785ae6f1356f01c2f3abf07d767e9332fb2805b"
+    );
+    assert_eq!(selector["frame"], acceptance["frame"]);
+    assert_eq!(acceptance["actual_completed_writer"]["ExecMainStatus"], "0");
+    assert_eq!(acceptance["actual_completed_writer"]["Result"], "success");
+    assert_eq!(acceptance["actual_completed_writer"]["MainPID"], "0");
+    assert_eq!(
+        seal["members"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .filter(|m| m["name"] == "jetstreamer-horizon-frame"
+                && m["sha256"] == QUALIFIED_SEALED_ALIAS_FRAME_CAPTURE_SHA)
+            .count(),
+        1
+    );
+    assert_eq!(
+        proof["artifact"]["sha256"],
+        QUALIFIED_SEALED_ALIAS_FRAME_CAPTURE_SHA
+    );
+    assert_eq!(proof["ordinary_tests_passed"], 50);
+    assert_eq!(proof["actual_native_saved_custody_passed"], 1);
+}
+#[test]
+fn immediate_sealed_alias_frame_accepts_a_distinct_successor_and_keeps_unknown_images_closed() {
+    let frame = previous();
+    let binding = json!({"path":"/test-only/actual0328.json","sha256":"fa5a8a0dece45f9cbc79488a3785ae6f1356f01c2f3abf07d767e9332fb2805b"});
+    let next = "a".repeat(64);
+    assert_ne!(frame["self_sha256"], next);
+    qualified_previous_recovery_envelope(&frame, &binding, &next).unwrap();
+    for (key, value) in [
+        ("self_sha256", json!("b".repeat(64))),
+        ("accepted_resource_lineage", json!(false)),
+        ("new_resource_observations", json!(1)),
+        ("native_census_after", json!({"foreign":true})),
+    ] {
+        let mut bad = frame.clone();
+        bad[key] = value;
+        assert!(
+            qualified_previous_recovery_envelope(&bad, &binding, &next).is_err(),
+            "{key}"
+        );
+    }
+}
