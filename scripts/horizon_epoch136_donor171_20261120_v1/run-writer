#!/usr/bin/env bash
# Run the sealed writer at the pathname used by the original epoch 136 payload.
set -euo pipefail

if [[ $# != 5 || ( $1 != preflight && $1 != session ) ]]; then
    echo 'usage: run-writer {preflight|session} PLAN SHA256 FLEET SHA256' >&2
    exit 2
fi

mode=$1
plan=$2
plan_sha=$3
fleet=$4
fleet_sha=$5
base=/home/sol/.jetstreamer-private/epoch136-actual-20261120-g1
runtime=/var/lib/jetstreamer/horizon_runtime_data
unit=horizon-admit-136-actual-20261120-g1.service

check_file() {
    local path=$1 expected=$2
    [[ $expected =~ ^[a-f0-9]{64}$ && -f $path && ! -L $path ]]
    [[ $(realpath -e "$path") == "$path" ]]
    [[ $(stat -c %u "$path") == 0 && $(stat -c %h "$path") == 1 ]]
    [[ $(sha256sum -- "$path" | cut -d' ' -f1) == "$expected" ]]
}

check_file "$plan" "$plan_sha"
check_file "$fleet" "$fleet_sha"
[[ $(basename -- "$fleet") == ROOT_COMPLETE_OPERATIONAL_FLEET.json ]]
[[ $(dirname -- "$(dirname -- "$fleet")") == "$runtime" ]]
[[ $(stat -c %a "$plan") == 400 || $(stat -c %a "$plan") == 444 ]]
seal=$(jq -er '.controller_deployment.path' "$plan")
check_file "$seal" "$(jq -er '.controller_deployment.sha256' "$plan")"
pkg=$(dirname -- "$seal")
fixture="$runtime/epoch136-joint-writer-20261122-v7b"
selector="$runtime/epoch145-fixture-phase-dispatch-20261122-v1/READY.json"
retry="$runtime/epoch136-joint-writer-20261122-v7c"
successor="$runtime/epoch136-joint-writer-20261123-v8"
if [[ $(realpath -e -- "$0") == "$retry/controller/run-writer" ]]; then
    fixture="$retry"
    selector="$runtime/epoch145-fixture-retry1-dispatch-20261122-v1/READY.json"
fi
if [[ $(realpath -e -- "$0") == "$successor/controller/run-writer" ]]; then
    fixture="$successor"
    selector="$runtime/epoch145-v5n-136-dispatch-20261123-v1/READY.json"
fi
if [[ $(realpath -e -- "$0") == "$fixture/controller/run-writer" ]]; then
    [[ $pkg == "$fixture/controller" ]]
    if [[ $mode == session ]]; then
        [[ $plan == "$fixture/registered-production-plan.json" ]]
        [[ $(jq -er '.holding145_prestart_ready.path' "$plan") == "$selector" ]]
    else
        [[ $plan == "$fixture/production-plan.json" || $plan == "$fixture/registered-production-plan.json" ]]
    fi
fi
[[ $seal == "$pkg/deployment-seal-receipt.json" && $pkg == "$runtime/"*/controller ]]
[[ $(jq -er '.controller.path' "$plan") == "$base/controller/admit136" ]]
image_sha=$(jq -er '.controller.sha256' "$plan")
check_file "$pkg/admit136" "$image_sha"
[[ $(stat -c %a "$pkg/admit136") == 555 ]]
jq -e --arg pkg "$pkg" --arg sha "$image_sha" '
    .schema == "jetstreamer-sealed-deployment-receipt-v1"
    and .destination == $pkg
    and .sealer_sha256 == "e0d565f4450b25b527ffd4455a52e1861568548b826e86a6894a1ae127e811f3"
    and ([.members[] | select(.name == "admit136" and .mode == "0555" and .sha256 == $sha)] | length == 1)
' "$seal" >/dev/null

props=(
    --property=CPUQuota=25%
    --property=MemoryMax=512M
    --property=MemorySwapMax=0
    --property=TasksMax=64
    --property=Restart=no
    --property=UMask=0077
    --property=PrivateNetwork=yes
    --property=ProtectSystem=full
    "--property=BindReadOnlyPaths=$pkg:$base/controller"
    --property=StandardOutput=journal
    --property=StandardError=journal
)
if [[ $mode == preflight ]]; then
    props+=("--property=ReadOnlyPaths=$base" --property=RuntimeMaxSec=300s)
else
    if [[ ${HORIZON_WAIT_FOR_136_WRITER:-0} == 1 ]]; then
        props+=(--wait)
    fi
    # The parent enters this writer's mount namespace for register-status,
    # whose checks consume the original fleet through its immutable path.
    copy="$runtime/epoch136-parent-handoff-20261121-v1/immutable-inputs/$fleet_sha.json"
    check_file "$copy" "$fleet_sha"
    [[ $(stat -c %a "$copy") == 400 ]]
    props+=("--property=BindReadOnlyPaths=$copy:$fleet")
    # The receipt directory and PID 1 masks are shared with the guarded helper.
    # The two /run mask directories must share a mount for the hard-link fence.
    props+=("--property=ReadOnlyPaths=$base/tools"
            --property=RuntimeMaxSec=45min)
fi
exec /usr/bin/systemd-run --unit="$unit" --collect --service-type=exec "${props[@]}" \
    "$base/controller/admit136" "$mode" "$plan" "$plan_sha" "$fleet" "$fleet_sha"
