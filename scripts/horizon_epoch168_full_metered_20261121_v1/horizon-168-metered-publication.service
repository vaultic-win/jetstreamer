[Unit]
Description=Submit the admitted epoch 168 publication after its accepted status report
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -IB /var/lib/jetstreamer/horizon_runtime_data/epoch168-current-delivery-20261121-v1/event-tools/retry10_event.py --metered168
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=180s
CPUQuota=50%
CPUWeight=10
Nice=15
MemoryMax=268435456
MemorySwapMax=0
TasksMax=32
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/jetstreamer/horizon_runtime_data/epoch168-current-delivery-20261121-v1
NoNewPrivileges=yes
