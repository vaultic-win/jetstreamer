[Unit]
Description=Verify natural completion of the original metered epoch 168 producer

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
CPUQuota=25%
CPUWeight=10
MemoryMax=128M
MemorySwapMax=0
TasksMax=16
TimeoutStartSec=350
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
ReadWritePaths=/var/lib/jetstreamer/horizon_runtime_data/epoch168-current-delivery-20261121-v1
ExecStart=/var/lib/jetstreamer/horizon_runtime_data/epoch168-current-delivery-20261121-v1/terminal-tools/terminal168 wait-record
