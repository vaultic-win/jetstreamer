+def incumbent_146_roster(fleet, native, owner):
+    rows = fleet["actual_executing_replays"]
+    count = fleet["canonical_producer_count"]
+    if owner is None:
+        return rows, count
+    need(owner == native["full146_census"], "unverified epoch 146 in the donor census")
+    peers = [row for row in rows if row["epoch"] == 146]
+    need(not any(row["epoch"] == 146 for key in ("actual_active_bootstraps",
+                                                  "actual_active_private_diagnostics")
+                 for row in fleet[key]), "overlapping epoch 146 claim in the donor census")
+    if not peers:
+        return rows, count
+    entry = fleet["current_full146"]
+    need(peers == [entry] and owner["mode"] == "active"
+         and entry["phase"] in ("bootstrap", "worker")
+         and entry["actor"] == owner["actor"] and entry["enrollment"] == owner["enrollment"]
+         and entry["unit"]["Id"] == owner["unit"] == owner["actor"]["producer_unit"]
+         and entry["unit"]["InvocationID"] == owner["actor"]["producer_invocation_id"],
+         "different epoch 146 claim in the donor census")
+    return [row for row in rows if row != entry], count - 1
+
