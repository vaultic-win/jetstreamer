[Unit]
Description=Bind the completed epoch 168 retry4 selector to its original joint comparison

[Service]
Type=oneshot
Environment=STATE_DIR=/var/lib/jetstreamer/horizon_runtime_data/epoch168-joint-checkpoint-reduced-run-20261126-v1
Environment=SELECTOR_DIR=/var/lib/jetstreamer/horizon_runtime_data/epoch168-retry4-selected-prefix-20261127-v1
ExecStart=/usr/bin/python3 -IB ${STATE_DIR}/lineage-handoff-tools-20261127-v3/epoch168_lineage_handoff.py verify ${STATE_DIR}/lineage-evidence-20261127-v1/COMPARISON_LAUNCH.json ${STATE_DIR}/lineage-evidence-20261127-v1/COMPARISON_NATIVE.json ${SELECTOR_DIR}/RESULT.stdout ${STATE_DIR}/lineage-binding-20261127-v3
User=root
Group=root
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/jetstreamer/horizon_runtime_data/epoch168-joint-checkpoint-reduced-run-20261126-v1/lineage-binding-20261127-v3
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
CPUQuota=100%
MemoryMax=256M
MemorySwapMax=0
LimitFSIZE=1048576
TimeoutStartSec=90s
Restart=no
