+    command = props(SERVICE, ('Id','ExecStart','TriggeredBy','CPUQuotaPerSecUSec','MemoryMax','MemorySwapMax'))
+    expected_workers = [] if worker is None else [worker['pid']]
+    witness_time = a['ready_at']
+    if worker:
+        boot, = (int(row.split()[1]) for row in Path('/proc/stat').read_text().splitlines() if row.startswith('btime '))
+        witness_time = max(witness_time,boot + worker['start_ticks']//os.sysconf('SC_CLK_TCK'))
+    walk = sample['root_physical_observation']
+    s.need(plan['schema'] == 'jetstreamer-horizon-standalone-guard-plan-v1'
+           and plan['unit'] == UNIT and plan['invocation_id'] == a['invocation_id']
+           and plan['worker_root'] == str(LANE) and plan['filesystem'] == '/home/sol'
+           and plan['maximum_root_physical_bytes'] == limits['whole_tree_cap_bytes']
+           and plan['minimum_free_bytes'] == limits['guard_floor_bytes']
+           and plan['maximum_worker_vmas'] == 3_500_000
+           and plan['receipt_directory'] == str(ROOT/'guard-receipts')
+           and tr['Id'] == TIMER and tr['ActiveState'] == 'active' and tr['SubState'] in ('waiting','running')
+           and tr['InvocationID'] == requested['timer_invocation_id'] and tr['Triggers'] == SERVICE and not tr['Job']
+           and command['Id'] == SERVICE and command['TriggeredBy'] == TIMER
+           and command['CPUQuotaPerSecUSec'] == '250ms'
+           and command['MemoryMax'] == str(GIB) and command['MemorySwapMax'] == '0'
+           and str(GUARD) in command['ExecStart'] and requested['plan']['path'] in command['ExecStart']
+           and requested['plan']['sha256'] in command['ExecStart'] and GUARD_SHA in command['ExecStart']
+           and sample['schema'] == 'jetstreamer-horizon-standalone-guard-sample-v1'
+           and sample.get('guard_sha256',sample.get('self_sha256')) == GUARD_SHA
+           and sample['plan'] == requested['plan']['path'] and sample['plan_sha256'] == requested['plan']['sha256']
+           and requested['sample']['path'] == str(ROOT/'guard-receipts'/f"sample-{sample['guard_invocation_id']}.json")
+           and sample['producer_invocation_id'] == sample['producer']['invocation_id'] == a['invocation_id']
+           and sample['producer']['pid'] == a['pid'] and sample['producer']['cgroup'] == GROUP
+           and sample['producer']['active'] == 'active' and sample['producer']['restarts'] == 0
+           and sample['recorded_unix_seconds'] >= witness_time
+           and 0 <= time.time()-sample['recorded_unix_seconds'] <= 120
+           and sample['producer_stop_enabled'] is True and sample['trip_reason'] is None
+           and sample['worker_observation_error'] is sample['root_physical_observation_error'] is None
