+def inspect(s, request, incumbent, status, tree_size, *, measured=None):
+    rr = retirement(s, request['retirement'])
+    mode = request['mode']
+    if mode == 'prestart':
+        s.need(not ENROLLMENT.exists(), 'joint 168 has an outstanding enrollment')
+        require_idle(s)
+        physical = tree_size(LANE,None) if measured is None else measured
+        return dict(mode=mode,retirement=rr,physical=physical,processes=[],**availability())
+    e,q = enrollment(s,request['enrollment'],request,incumbent,status)
+    p = load_payload(s,e,q)
+    unit, processes, worker = native(s,e,p,mode)
+    if request['guard'] is None:
+        s.need(mode == 'held', 'released joint 168 requires live protective guard evidence')
+        protected = None
+        physical = tree_size(LANE,None) if measured is None else measured
+    else:
+        protected = protective(s,request['guard'],e,q,worker)
+        physical = protected['physical']
+    release = validate_release(s,e,q,request,protected) if mode == 'active' else None
+    return dict(mode=mode,retirement=rr,physical=physical,processes=processes,unit=unit,worker=worker,release=release,
+                actor=e['actor'],enrollment=request['enrollment'],prestart=e['prestart_quote'],
+                first_fit=q['joint168'],guard=protected,**availability())
