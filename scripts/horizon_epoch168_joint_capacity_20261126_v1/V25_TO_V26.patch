+def validate_release(s, e, q, request, guard):
+    record, ref = s.read(RELEASE)
+    held = read(s, record['post_guard_fit'])
+    a = e['actor']
+    fit_guard = held['native_joint168']['guard']
+    permit = Path('/proc')/str(a['pid'])/'root'/ALIAS.relative_to('/')/'barrier/allow'
