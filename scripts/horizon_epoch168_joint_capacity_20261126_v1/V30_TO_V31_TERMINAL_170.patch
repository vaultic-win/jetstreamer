+         and exit_event['_PID'] == '1' and exit_event['INVOCATION_ID'] == IID
+         and exit_event['UNIT'] == metered.UNIT and exit_event['CODE_FUNC'] == 'unit_log_success'
+         and int(exit_event['__REALTIME_TIMESTAMP'])//1_000_000 == int(utc(EXIT).timestamp())
