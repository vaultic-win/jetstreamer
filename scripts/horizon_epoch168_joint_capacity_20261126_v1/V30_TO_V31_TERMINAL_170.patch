+        archive = dict(path=str(path), device=meta.st_dev, inode=meta.st_ino, size=meta.st_size, complete=False)
+        estimate = dict(exit_utc=failure['exit_utc'], archive_or_bank_resume_claimed=False, **terms)
+    need(age >= 0 and remaining > 0 and elapsed >= prior['elapsed_execution_millis'],
