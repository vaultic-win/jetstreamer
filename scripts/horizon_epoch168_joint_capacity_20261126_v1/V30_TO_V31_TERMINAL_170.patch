+    guard = raised.TIMER.removesuffix('.timer')+'.service'
+    for unit in (metered.UNIT, raised.TIMER, guard):
+        row = show(unit, MANAGER_FIELDS)
+        acceptable = ('inactive',) if unit.endswith('.timer') else ('inactive', 'failed')
+        need(row['Id'] == unit and row['ActiveState'] in acceptable
+             and all(row.get(key, '0') == '0' for key in ('MainPID', 'ControlPID'))
+             and not any(row.get(key) for key in ('ControlGroup', 'Job'))
+             and row.get('Triggers', '') in (('', guard) if unit == raised.TIMER else ('',))
+             and not (Path('/sys/fs/cgroup/system.slice')/unit).exists(), 'epoch 170 owner is occupied: '+unit)
