+    post_ref = admission['post_guard_capacity']
+    book = checked(post_ref)['bookings']['170']
+    need(terminal['schema'] == 'horizon-epoch170-full-metered-guard-stop-v1'
+         and terminal['epoch'] == 170 and terminal['producer_invocation_id'] == IID
+         and terminal['producer_unit'] == metered.UNIT
+         and terminal['admission'] == admission_ref and terminal['first_worker'] == worker_ref
+         and terminal['stop_intent'] == intent_ref and terminal['stop_completion'] == completion_ref
