+        elapsed = round((exited-started).total_seconds()*1000)
+        model = ('repair_and_requalification_ms','full_replay_with_10pct_ms','delivery_tail_ms')
+        terms = {key: stop_model[key] for key in model}
+        need(all(value > 0 for value in terms.values()), 'missing retained 170 recovery estimates')
+        remaining = sum(terms.values()) - round((c.now-exited).total_seconds()*1000)
