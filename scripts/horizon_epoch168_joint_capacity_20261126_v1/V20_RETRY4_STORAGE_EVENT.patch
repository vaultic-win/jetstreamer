+fn active_home_bound(q: &Value, fleet: &Value) -> Result<u64> {
+    let previous = amount(fleet, "complete_cycle_conservative_available_DATA_bytes")?;
+    let Some(event) = q.get("joint168_storage_event") else {
+        return Ok(previous);
+    };
+    const BASE: &str = "/var/lib/jetstreamer/horizon_runtime_data/epoch168-retry4-closed-accounts-20261126-v1/state/cold-retry4";
+    let done_path = Path::new(BASE).join("COMPLETE.json");
+    let check_path = Path::new(BASE).join("CHECK.json");
+    ensure!(
+        event["retirement"] == q["joint168_census"]["retirement"]
+            && text(&event["retirement"], "path")? == done_path.to_string_lossy()
+            && text(&event["check"], "path")? == check_path.to_string_lossy(),
+        "foreign epoch 168 storage retirement event"
+    );
+    let completion = read_bound(&event["retirement"])?;
+    let check = read_bound(&event["check"])?;
+    let stopped = amount(&completion, "retired_tree_before_bytes")?;
+    ensure!(
+        completion["schema"] == "horizon168-retry4-stopped-accounts-complete-v1"
+            && completion["original_iid"] == "913443d7f9f44d7e9d3e0eec420acfab"
+            && completion["scope_empty"] == true
+            && completion["archive_or_snapshot_removed"] == false
+            && completion["resource_credit_bytes"] == 0
+            && completion["check_sha256"] == event["check"]["sha256"]
+            && check["schema"] == "horizon168-retry4-stopped-accounts-check-v1"
+            && amount(&check, "allocated_bytes")? == stopped,
+        "changed epoch 168 storage retirement scope"
+    );
+    let started = u64::try_from(fs::metadata(check_path)?.mtime())?;
+    let completed = u64::try_from(fs::metadata(done_path)?.mtime())?;
+    ensure!(started <= completed, "retirement precedes its check");
+    let released = if started > amount(fleet, "recorded_unix_seconds")? {
+        stopped
+            .checked_sub(amount(&completion, "scope_root_remaining_bytes")?)
+            .context("inconsistent reclaimed epoch 168 bytes")?
+    } else {
+        0
+    };
+    let upper = previous
+        .checked_add(released)
+        .context("HOME accounting overflow")?;
+    ensure!(
+        amount(event, "last_fleet_available_bytes")? == previous
+            && amount(event, "post_fleet_retirement_bytes")? == released
+            && amount(event, "fleet_available_upper_bound")? == upper,
+        "changed accepted storage bound or retirement contribution"
+    );
+    Ok(upper)
+}
