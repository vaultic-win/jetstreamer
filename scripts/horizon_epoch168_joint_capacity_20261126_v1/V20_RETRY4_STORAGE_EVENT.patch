+def fleet_storage_bound(s, fleet, ref):
+    # Conservatively advance the last coordinated lower bound only for this
+    # exact completed retirement, and leave the current statvfs bound in place.
+    previous = fleet['complete_cycle_conservative_available_DATA_bytes']
+    receipt = read(s, retirement(s, ref))
+    check_path = Path(ref['path']).with_name('CHECK.json')
+    check_ref = dict(path=str(check_path), sha256=receipt['check_sha256'])
+    check = read(s, check_ref)
+    completion_path = Path(ref['path'])
+    s.need(check['schema'] == 'horizon168-retry4-stopped-accounts-check-v1'
+           and check['allocated_bytes'] == receipt['retired_tree_before_bytes']
+           and check_path.stat().st_mtime_ns <= completion_path.stat().st_mtime_ns,
+           'joint 168 storage event lacks its completed original CHECK')
+    release = receipt['retired_tree_before_bytes'] - receipt['scope_root_remaining_bytes']
+    after_sample = check_path.stat().st_mtime_ns // 1_000_000_000 > fleet['recorded_unix_seconds']
+    addition = release if after_sample else 0
+    return dict(retirement=ref, check=check_ref, last_fleet_available_bytes=previous,
+                post_fleet_retirement_bytes=addition, fleet_available_upper_bound=previous+addition)


