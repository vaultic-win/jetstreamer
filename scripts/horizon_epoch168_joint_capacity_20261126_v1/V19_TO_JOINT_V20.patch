+    a = enrolled['actor']
+    expected = dict(phase='worker-ready',epoch=168,producer_invocation_id=a['invocation_id'],
+                    producer_pid=a['pid'],producer_start_ticks=a['start_ticks'],
+                    worker_ready_unix_seconds=a['ready_at'],payload_sha256=enrolled['payload']['sha256'])
+    s.need(events == [expected], 'joint 168 missing exact native worker-ready event')
