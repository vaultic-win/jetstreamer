+        worker_proc = Path('/proc')/str(who)
+        path = (worker_proc/'exe').readlink()
+        ws = (worker_proc/'exe').stat()
+        parent = int((worker_proc/'stat').read_text().rsplit(')',1)[1].split()[1])
+        s.need(mode == 'active' and path.name == 'historical-worker' and path.parent.name == 'bound-worker'
