+        s.need((proc/'exe').samefile(main) and sha(proc/'exe') == NODE_SHA and args == p['regular_node_argv']
+               and stat.S_ISREG(pm.st_mode) and pm.st_uid == 0 and pm.st_nlink == 1
+               and stat.S_IMODE(pm.st_mode) == 0o444 and pm.st_size == 32
