+    s.need(u['Id'] == UNIT and u['ActiveState'] == 'active' and u['SubState'] == 'running'
+           and u['InvocationID'] == a['invocation_id'] and u['MainPID'] == str(pid)
+           and re.fullmatch('[a-f0-9]{32}',a['invocation_id']) and int(a['invocation_id'],16)
+           and Path('/proc/sys/kernel/random/boot_id').read_text().strip() == a['boot_id']
+           and ticks(pid) == a['start_ticks'] and u['ControlGroup'] == GROUP
+           and (proc/'cgroup').read_text().strip() == '0::'+GROUP
+           and u['ControlPID'] == u['NRestarts'] == '0' and not u['Job']
+           and u['Restart'] == 'no' and u['KillMode'] == 'control-group'
+           and cgroup_limits(CGROUP,1_750_000,63*GIB)
+           and (CGROUP/'memory.high').read_text().strip() == str(60*GIB)
+           and pid in members and len(members) <= 2, 'joint 168 manager/cgroup or process incarnation changed')
+    projections(s,proc/'root',p,e['payload'])
