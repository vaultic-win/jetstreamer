+        origin = Path(row['source']['path'])
+        get = target.stat()
+        s.need(stat.S_ISREG(get.st_mode) and os.statvfs(target).f_flag & os.ST_RDONLY
+               and file_id(get) == row['source']['identity'] == file_id(origin.lstat()),
+               'joint 168 changed read-only projection: '+row['target'])
+    projected_payload = proc_root/ALIAS.relative_to('/')/'payload.json'
+    s.need(projected_payload.samefile(ref['path']) and os.statvfs(projected_payload).f_flag & os.ST_RDONLY
+           and sha(projected_payload) == ref['sha256'], 'joint 168 payload mount changed')
