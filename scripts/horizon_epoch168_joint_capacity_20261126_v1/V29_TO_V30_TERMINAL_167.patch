+        size = meta.st_size
+        archive = dict(path=str(path), device=meta.st_dev, inode=meta.st_ino, size=size, complete=False)
+        estimate = dict(source=checked(EVENT)['reports'][str(EPOCH)], terminal=exited,
+                        repair_and_requalification_ms=model['repair_and_requalification_ms'],
