+         'epoch 167 terminal does not follow its authenticated producer status')
+    age = round((c.now - utc(prior['sampled_at_utc'])).total_seconds()*1000)
+    if same:
+        remaining = prior['estimated_remaining_millis'] - age
+        elapsed = prior['elapsed_execution_millis']
+        size = prior['jet_size_bytes']
+        archive = old['archive_sample']
+        estimate = old['terminal_delivery_estimate']
+    else:
+        term = checked(failure['terminal'])
+        stop = checked(checked(EVENT)['reports'][str(EPOCH)])
