+        exited = int(term['manager_exit']['__REALTIME_TIMESTAMP']) // 1000
+        remaining = exited + estimated - round(c.now.timestamp()*1000)
+        started = utc_date(failure['historical_replay']['unit']['ExecMainStartTimestamp'])
+        elapsed = exited - round(started.timestamp()*1000)
+        prior_archive = old['archive_sample']
+        path = Path(prior_archive['path'])
+        expected = Path(failure['observer_config']['scratch_path']).parent/'archives'/f'epoch-{EPOCH}.jet'
