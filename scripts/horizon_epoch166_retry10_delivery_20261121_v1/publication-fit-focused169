#!/usr/bin/python3 -IB
"""Price a five-source publisher while retaining the focused 169 diagnostic's original booking."""
import hashlib
import json
import os
from pathlib import Path
import runpy
import sys
import time

ROOT = Path("/var/lib/jetstreamer/horizon_runtime_data")
INCIDENT = ROOT / "incident-replay-fit-20261121-v1"
BASE = INCIDENT / "tools-v12/publication-fit"
if hashlib.sha256(BASE.read_bytes()).hexdigest() != "3c30f24d37e4848c65a59f6feccc46bd0430ee3e4082816e983129d9ae2ba5b6":
    raise ValueError("unrecognized five-source publication pricing")
base = runpy.run_path(str(BASE))
need, read = base["need"], base["read"]
FOCUSED = ROOT / "epoch169-focused-terminal-20261121-v1"
LIVE = "60b076b21cae35dbc206bc782fb596f782df4039d7d22a1113acf2e06483c779"
PACKAGES = {epoch: base["PACKAGES"][epoch].parent / ("capacity-tools-v" + str(version))
            for epoch, version in [(166,5), (167,3), (168,4), (170,3), (172,2)]}
PROVIDER = INCIDENT / "tools-v13/post-stop-fit"


def document(path, mode):
    raw, ref = read(path, mode)
    return json.loads(raw), ref


def focused(value, fleet):
    live, witness = document(FOCUSED / "LIVE.json", 0o400)
    need(witness["sha256"] == LIVE, "different focused 169 witness")
    term = fleet.get("focused169_terminal")
    guard = fleet.get("focused169_guard_retirement")
    closed = value["closed_focused169"]
    unit = live["producer_unit"]
    original = live["original"]
    if closed is None:
        actor = value["survivors"]["169"]
        need(term is None and guard is None and unit in value["population"] and
             actor["unit"] == unit and actor["invocation_id"] == live["producer_invocation_id"] and
             actor["guard"]["plan"] == original["actual_guard_plan"], "different live focused 169")
        return None
    need(closed["terminal"] == term and closed["guard_retirement"] == guard and
         term["path"] == str(FOCUSED/"TERMINAL.json") and guard["path"] == str(FOCUSED/"TERMINAL_GUARD_DRAINED.json") and
         closed["live"] == witness and closed["producer_invocation_id"] == live["producer_invocation_id"] and
         closed["timer_invocation_id"] == live["timer_invocation_id"] and closed["resource_credit_bytes"] == 0 and
         all(closed[k] == original[k] for k in ("first_guard","admission","actual_guard_plan")) and
         closed["disposition"] in ("completed-private-span","diagnosed-target-mismatch","interrupted-or-unclassified") and
         unit not in value["population"] and "169" not in value["survivors"] and
         "169" not in value["joined_resident_lower_bounds"] and "169" not in value["replacements"] and
         all(row["epoch"] != 169 for group in ("actual_executing_replays","actual_active_bootstraps","actual_active_private_diagnostics")
             for row in fleet[group]), "different closed focused 169")
    booked = value["bookings"]["169"]
    equation = value["registered_host_equation"]
    need(booked["root"] == live["booked_tree"]["path"] and booked["plan"] == original["actual_guard_plan"] and
         booked["measurement"] == "two complete stopped-tree walks" and booked["physical_bytes"] > 0 and
         booked["remaining_bytes"] >= 0 and booked["physical_bytes"] + booked["remaining_bytes"] == booked["cap_bytes"] == 96 << 30 and
         booked["historical_realized_bytes"] == 0 and equation["retained_169_remaining"] == booked["remaining_bytes"] and
         equation["retained_169_plan"] == booked["plan"], "focused 169 retained booking changed")
    return closed


def price(value, fleet, fleet_ref, terminal, epoch):
    closure = focused(value, fleet)
    floor = base["validate"](value, fleet, fleet_ref, terminal, epoch)
    return floor, closure


def capture(epoch, path, digest):
    fleet, fr = document(path, 0o600)
    need(path.parent.parent == ROOT and path.name == "ROOT_COMPLETE_OPERATIONAL_FLEET.json" and
         fr["sha256"] == digest, "wrong fleet")
    term_path = base["TERMINALS"][epoch] / "TERMINAL_SUCCESS.json"
    _, terminal = document(term_path, 0o400)
    need(fleet[base["FLEET_FIELDS"][epoch]] == terminal, "no adopted publisher terminal")
    package = PACKAGES[epoch]
    manifest, _ = document(package/"deployment-seal-receipt.json", 0o444)
    binding, record = document(package/"provider.json", 0o444)
    _, provider_ref = read(PROVIDER, 0o555)
    need(binding == provider_ref and manifest["destination"] == str(package) and any(
         m["name"] == "provider.json" and m["sha256"] == record["sha256"] for m in manifest["members"]),
         "foreign focused 169 provider")
    profile = None
    proofs = []
    for _ in range(2):
        raw = base["capture_provider"](PROVIDER, str(path), digest)
        value = json.loads(raw)
        floor, closed = price(value, fleet, fr, terminal, epoch)
        current = (base["identity"](value),value["phase145"],value["candidate136"],base["closing"](value,fleet),
                   value["status_registration"],closed,value["bookings"].get("169"))
        need(profile is None or profile == current, "publication population or focused 169 booking changed")
        profile = current
        proofs.append(dict(sha256=hashlib.sha256(raw).hexdigest(),recorded_unix_seconds=value["recorded_unix_seconds"],
                           available_home=value["available_HOME_bytes"],required_home=value["complete_required_HOME_bytes"],
                           available_memory=value["available_memory_bytes"],required_memory=value["required_available_memory_bytes"]))
    need(read(path,0o600)[1] == fr and read(term_path,0o400)[1] == terminal, "publication evidence changed")
    return dict(schema=f"horizon-{epoch}-publication-fit-v1",fleet=fr,terminal=terminal,
                boot_id=Path("/proc/sys/kernel/random/boot_id").read_text().strip(),observed_unix_seconds=int(time.time()),
                available_bytes=value["available_HOME_bytes"],protected_bytes=floor,available_memory_bytes=value["available_memory_bytes"],
                required_available_memory_bytes=value["required_available_memory_bytes"],publication_cpu_quota_micros=500000 if epoch==172 else 1000000,
                publication_memory_bytes=2<<30,complete_cpu_quota_micros=value["complete_cpu_quota_micros"],
                complete_memory_plus_reserve_bytes=base["MEM"],resource_credit_bytes=0,all_existing_commitments_retained=True,
                full_capacity_provider=provider_ref,complete_captures=proofs,source_booking=value["bookings"][str(epoch)],
                funded_extra_home_bytes=len(base["closing"](value,fleet))*base["BOOK"],charged_to_original_epoch=epoch,
                closed_focused169=closed,**{field:value.get(field) for field in base["CLOSURES"].values()})


if __name__ == "__main__":
    need(os.geteuid()==0 and __debug__ and sys.flags.isolated and len(sys.argv)==3, "expected FLEET SHA256")
    own = Path(__file__).resolve(strict=True)
    epoch = next((e for e,folder in PACKAGES.items() if own == folder/"publication-fit"),None)
    need(epoch is not None, "unregistered focused 169 publication adapter")
    print(json.dumps(capture(epoch,Path(sys.argv[1]),sys.argv[2]),sort_keys=True))
