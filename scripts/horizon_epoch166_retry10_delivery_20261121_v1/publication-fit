#!/usr/bin/python3 -IB
"""Price the recovered epoch's delivery on the original booking and accepted full fleet."""
import hashlib
import json
import os
import select
from pathlib import Path
import stat
import subprocess
import sys
import time

R=Path("/var/lib/jetstreamer/horizon_runtime_data")
D=R/"epoch166-retry10-delivery-20261121-v1"
T=R/"epoch166-retry10-terminal-20261121-v1"
BOOK=16<<20
MEM=810658050048
FULL168=R/"epoch168-current-delivery-20261121-v1"
FLEET_FIELDS={166:"recovered166_local_commit",167:"indexed167_local_commit",168:"metered168_local_commit",170:"recovered170_local_commit",172:"full172_local_commit"}
CLOSURES={166:"closed_recovered166",167:"closed_indexed167",168:"closed_metered168",170:"closed_recovered170",172:"closed_full172"}
TERMINALS={166:T,168:FULL168,**{e:R/f"epoch{e}-current-delivery-20261121-v1" for e in (167,170,172)}}
PACKAGES={166:D/"capacity-tools-v4",168:FULL168/"capacity-tools-v3",172:TERMINALS[172]/"capacity-tools",
          **{e:TERMINALS[e]/"capacity-tools-v2" for e in (167,170)}}
CAPS={166:288<<30,167:512<<30,168:288<<30,170:384<<30,172:288<<30}
# Exact unused allowances in the three authenticated, pre-launch START_INTENT receipts.
PRESTART={166:169028829184,167:177601941504,170:230591926272}

def need(ok,why):
    if not ok:raise ValueError(why)

def read(path,mode,limit=32<<20):
    need(path.is_absolute() and path.resolve(strict=True)==path,"noncanonical capacity input")
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),"rb") as f:
        m=os.fstat(f.fileno())
        need(stat.S_ISREG(m.st_mode) and stat.S_IMODE(m.st_mode)==mode and m.st_uid==m.st_gid==0 and
             m.st_nlink==1 and 0<m.st_size<=limit,"untrusted capacity input "+str(path))
        data=f.read(limit+1)
        need(len(data)==m.st_size and os.fstat(f.fileno()).st_ctime_ns==m.st_ctime_ns and os.path.samestat(m,path.lstat()),"capacity input changed")
    return data,dict(path=str(path),sha256=hashlib.sha256(data).hexdigest())

def identity(value):
    return {k:tuple(tuple(p) for p in v) for k,v in value['population'].items()}

def closing(value,fleet):
    result={}
    for epoch,field in FLEET_FIELDS.items():
        registered=fleet.get(field)
        proof=value.get(CLOSURES[epoch])
        need((registered is None)==(proof is None),"fleet and native closure differ")
        if proof is not None:
            need(isinstance(proof,dict) and proof.get("terminal")==registered and isinstance(registered,dict) and proof.get("resource_credit_bytes")==0,"different epoch terminal")
            result[epoch]=proof
    return result

def validate(value,fleet,fr,tr,epoch=166):
    closed=closing(value,fleet)
    expected={row["unit"]["Id"] for group in ("actual_executing_replays","actual_active_bootstraps","actual_active_private_diagnostics") for row in fleet[group]}
    need(value["schema"]=="horizon-incident-replay-fit-v1" and value["epoch"]==145 and value["fleet"]==fr and value["fits"] and
         epoch in closed and tr==closed[epoch]["terminal"] and set(value["population"])==expected and
         value["complete_cpu_quota_micros"]==64000000 and value["complete_memory_plus_reserve_bytes"]==MEM and
         value["resource_credit_bytes"]==value["stopped_generation_resident_credit_bytes"]==0 and
         value["replay_launch_authorized"] is False and 0<=time.time()-value["recorded_unix_seconds"]<=180,
         "different joined reservation or population")
    need(value["closed_prestart_remaining"]=={str(e):PRESTART[e] for e in closed if e in PRESTART},
         "closed prepaid allowances differ from the original admissions")
    for e in closed:
        key=str(e);booking=value["bookings"][key]
        need(key not in value["joined_resident_lower_bounds"] and key not in value["replacements"] and
             not any(row["epoch"]==e for group in ("actual_executing_replays","actual_active_bootstraps","actual_active_private_diagnostics") for row in fleet[group]) and
             (e not in PRESTART or key not in fleet["original_disk_guard_recovery_workers"]) and
             (e!=168 or value["normal168"] is None and value["active168_guard_floor"]==0 and
              value["registered_host_equation"]["retained_168_remaining"]==booking["remaining_bytes"]) and
             (e!=172 or key not in value["survivors"] and value["registered_host_equation"]["retained_172_remaining"]==booking["remaining_bytes"]
              and value["registered_host_equation"]["retained_172_plan"]==booking["plan"]
              and fleet.get("full172_guard_retirement")==closed[172]["guard_retirement"]) and
             booking["measurement"]=="two complete stopped-tree walks" and booking["physical_bytes"]>0 and
             booking["remaining_bytes"]+booking["physical_bytes"]==booking["cap_bytes"]==CAPS[e],"closed booking or owner changed")
    memory=MEM-sum(p["resident"] for p in value["survivors"].values())-sum(value["joined_resident_lower_bounds"].values())
    need(value["required_available_memory_bytes"]==memory,"different complete memory equation")
    # Each closed archive may be verified concurrently on its own retained CPU/RAM
    # allowance. Reserve the small additional HOME staging once for each such publisher.
    floor=value["complete_required_HOME_bytes"]+len(closed)*BOOK
    need(value["available_HOME_bytes"]>=floor and value["available_memory_bytes"]>=value["required_available_memory_bytes"]>0,
         "insufficient publication capacity")
    return floor

def wait_for_145_probe():
    # A concurrent full census is a descendant of the frozen 145 verifier. Wait
    # for that exact process to exit, then discard every earlier fit measurement.
    unit="horizon-holding-export145-20261121-v1.service"
    scope=Path("/sys/fs/cgroup/system.slice")/unit
    evidence=R/"epoch145-semantic-continuity-20261121-v1/V5C_ACTUAL_ADVANCING_WORKER.json"
    data,ref=read(evidence,0o400)
    need(ref["sha256"]=="6235fbd8e36064d57a9cd6b7af2ad0d05ce8b41766134cde7be7337ebc133d76","foreign 145 advancing witness")
    witness=json.loads(data);sample=witness["observations"][-1];iid=witness["invocation_id"]
    manager,worker=sample["parent_pid"],sample["child_pid"]
    image=evidence.parent/"tools-v5c/export145"
    for pid,ticks in ((manager,sample["parent_ticks"]),(worker,sample["child_ticks"])):
        proc=Path("/proc")/str(pid)
        need(int((proc/"stat").read_text().rsplit(")",1)[1].split()[19])==ticks and (proc/"exe").samefile(image) and (proc/"cgroup").read_text().strip()=="0::/system.slice/"+unit and
             ("INVOCATION_ID="+iid).encode() in (proc/"environ").read_bytes().split(b"\0"),"foreign 145 verifier")
    candidates=set(map(int,(scope/"cgroup.procs").read_text().split()))-{manager,worker}
    if not candidates:return
    original=R/"incident-replay-fit-20261121-v1/tools-v10/post-stop-fit"
    need(read(original,0o555)[1]["sha256"]=="d5ed981b98ad6fc2c54843667852e9d3c3567c764398b644afac00231cd2940d","different 145 internal provider")
    for pid in candidates:
        try:
            proc=Path("/proc")/str(pid)
            fd=os.pidfd_open(pid)
            try:
                args=(proc/"cmdline").read_bytes().decode().strip("\0").split("\0")
                if (not (proc/"exe").samefile("/usr/bin/python3") or len(args)!=6 or
                    args[:4]!=["/usr/bin/python3","-IB",str(original),"145"] or
                    int((proc/"stat").read_text().rsplit(")",1)[1].split()[1])!=manager):continue
                fleet=Path(args[4])
                need(fleet.parent.parent==R and fleet.name=="ROOT_COMPLETE_OPERATIONAL_FLEET.json" and read(fleet,0o600)[1]["sha256"]==args[5],
                     "foreign 145 internal census fleet")
                need(select.select([fd],[],[],120)[0],"145 census deadline")
                return
            finally:os.close(fd)
        except (FileNotFoundError,ProcessLookupError):continue
    need(set(map(int,(scope/"cgroup.procs").read_text().split()))=={manager,worker},"unidentified 145 descendant")

def capture_provider(provider,path,digest):
    for attempt in range(3):
        result=subprocess.run([provider,"145",path,digest],capture_output=True,timeout=150)
        if result.returncode==0:return result.stdout
        if attempt==2 or b"foreign 145 descendants" not in result.stderr and b"capacity generation changed during collection" not in result.stderr:
            raise RuntimeError(result.stderr.decode(errors="replace")[-1800:])
        if b"foreign 145 descendants" in result.stderr:wait_for_145_probe()

def capture(path,sha,epoch=166):
    terminal=TERMINALS[epoch]/"TERMINAL_SUCCESS.json"
    pkg=PACKAGES[epoch]
    raw,fr=read(path,0o600);fleet=json.loads(raw)
    need(path.parent.parent==R and path.name=="ROOT_COMPLETE_OPERATIONAL_FLEET.json" and fr["sha256"]==sha,"wrong fleet")
    _,tr=read(terminal,0o400)
    need(fleet.get(FLEET_FIELDS[epoch])==tr,"no accepted recovered commit")
    snapshot,sr=read(pkg/"deployment-seal-receipt.json",0o444);seal=json.loads(snapshot)
    refdata,rr=read(pkg/"provider.json",0o444);binding=json.loads(refdata)
    elf=Path(binding["path"]);_,pr=read(elf,0o555)
    need(seal["destination"]==str(pkg) and any(x["name"]=="provider.json" and x["sha256"]==rr["sha256"] for x in seal["members"]) and
         pr==binding and elf.parent.parent==R/"incident-replay-fit-20261121-v1" and elf.name=="post-stop-fit","unsealed capacity provider")
    results=[];refs=[]
    for _ in range(2):
        data=capture_provider(elf,path,sha)
        v=json.loads(data);validate(v,fleet,fr,tr,epoch);results.append(v)
        refs.append(dict(sha256=hashlib.sha256(data).hexdigest(),recorded_unix_seconds=v["recorded_unix_seconds"],
                         available_home=v["available_HOME_bytes"],required_home=v["complete_required_HOME_bytes"],
                         available_memory=v["available_memory_bytes"],required_memory=v["required_available_memory_bytes"]))
    a,b=results
    need(identity(a)==identity(b) and a["phase145"]==b["phase145"] and a["candidate136"]==b["candidate136"] and
         closing(a,fleet)==closing(b,fleet) and a["status_registration"]==b["status_registration"] and
         read(path,0o600)[1]==fr and read(terminal,0o400)[1]==tr,"capacity population changed between captures")
    return dict(schema=f"horizon-{epoch}-publication-fit-v1",fleet=fr,terminal=tr,boot_id=Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
                observed_unix_seconds=int(time.time()),available_bytes=b["available_HOME_bytes"],protected_bytes=validate(b,fleet,fr,tr,epoch),
                available_memory_bytes=b["available_memory_bytes"],required_available_memory_bytes=b["required_available_memory_bytes"],
                publication_cpu_quota_micros=500000 if epoch==172 else 1000000,publication_memory_bytes=2<<30,complete_cpu_quota_micros=64000000,
                complete_memory_plus_reserve_bytes=MEM,resource_credit_bytes=0,all_existing_commitments_retained=True,
                full_capacity_provider=pr,complete_captures=refs,source_booking=b["bookings"][str(epoch)],funded_extra_home_bytes=len(closing(b,fleet))*BOOK,
                charged_to_original_epoch=epoch,**{field:b.get(field) for field in CLOSURES.values()})

if __name__=="__main__":
    need(os.geteuid()==0 and __debug__ and sys.flags.isolated and len(sys.argv)==3,"expected FLEET SHA256")
    path=Path(__file__).resolve(strict=True)
    selected=next((e for e,pkg in PACKAGES.items() if path==pkg/"publication-fit"),None)
    need(selected is not None,"unregistered publication capacity image")
    print(json.dumps(capture(Path(sys.argv[1]),sys.argv[2],selected),sort_keys=True))
