def need(ok,why):
    if not ok:raise ValueError(why)

def read(path,mode,limit=32<<20):
    need(path.is_absolute() and path.resolve(strict=True)==path,"noncanonical capacity input")
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),"rb") as f:
        m=os.fstat(f.fileno())
        need(stat.S_ISREG(m.st_mode) and stat.S_IMODE(m.st_mode)==mode and m.st_uid==m.st_gid==0 and
             m.st_nlink==1 and 0<m.st_size<=limit,"untrusted capacity input "+str(path))
        data=f.read(limit+1)
        need(len(data)==m.st_size and os.fstat(f.fileno()).st_ctime_ns==m.st_ctime_ns and os.path.samestat(m,path.lstat()),"capacity input changed")
    return data,dict(path=str(path),sha256=hashlib.sha256(data).hexdigest())

def identity(value):
    return {k:tuple(tuple(p) for p in v) for k,v in value['population'].items()}

def diagnostic(value,fleet):
    registered=fleet.get("focused169_terminal");retirement=fleet.get("focused169_guard_retirement")
    proof=value.get("closed_focused169")
    need((registered is None)==(retirement is None)==(proof is None),"split focused 169 terminal")
    if proof is None:
        need("169" in value["survivors"] and "169" not in value["bookings"],"lost or repeated focused 169 booking")
        return
    book=value["bookings"]["169"];eq=value["registered_host_equation"]
    need(proof["terminal"]==registered and proof["guard_retirement"]==retirement and proof["resource_credit_bytes"]==0 and
         proof["producer_invocation_id"]=="0dfa0d36fbc246c28443a1c90a82c9cb" and
         str(TERMINALS[172].parent/"epoch169-focused-terminal-20261121-v1/TERMINAL.json")==registered["path"]
         and proof["disposition"] in ("completed-private-span","diagnosed-target-mismatch","interrupted-or-unclassified")
         and book["cap_bytes"]==96<<30 and 0<=book["remaining_bytes"]<=book["cap_bytes"] and
         book["remaining_bytes"]+book["physical_bytes"]==book["cap_bytes"] and book["plan"]==eq["retained_169_plan"]==proof["actual_guard_plan"]
         and book["remaining_bytes"]==eq["retained_169_remaining"] and book["measurement"]=="two complete stopped-tree walks"
         and "169" not in value["survivors"] and "169" not in value["joined_resident_lower_bounds"] and
         not any(r["epoch"]==169 for g in ("actual_executing_replays","actual_active_bootstraps","actual_active_private_diagnostics") for r in fleet[g]),"different focused 169 retained obligation")

def closing(value,fleet,cold170=False,cold168=False):
    diagnostic(value,fleet)
    result={}
    for epoch,field in FLEET_FIELDS.items():
        registered=fleet.get(field)
        proof=value.get(CLOSURES[epoch])
        need((registered is None)==(proof is None),"fleet and native closure differ")
        if proof is not None:
            need(isinstance(proof,dict) and proof.get("terminal")==registered and isinstance(registered,dict) and proof.get("resource_credit_bytes")==0,"different epoch terminal")
            result[epoch]=proof
    if cold170:
        proof=value["closed_cold170"]
        need(170 not in result and proof["terminal"] == fleet["cold170_local_commit"]
             and proof["terminal"]["path"] == str(COLD170_ROOT/"TERMINAL_SUCCESS.json")
             and proof["producer_invocation_id"] == "c44b5215f8d949159e7ce9cf911e9be1"
             and proof["guard_retirement"] == fleet["cold170_guard_retirement"]
             and proof["guard_retirement"]["path"] == str(COLD170_ROOT/"TERMINAL_GUARD_DRAINED.json")
             and proof["resource_credit_bytes"] == 0, "different cold170 commit or drain")
        result[170]=proof
    if cold168:
        proof=value["closed_cold168"]
        reserve=fleet["retained_cold168_retry4_reservation"]
        need(168 not in result and proof["terminal"] == fleet["cold168_local_commit"] == reserve["terminal"]
             and proof["terminal"]["path"] == str(COLD168_ROOT/"TERMINAL_SUCCESS.json")
             and proof["producer_invocation_id"] == "913443d7f9f44d7e9d3e0eec420acfab"
             and proof["guard_retirement"] == fleet["cold168_guard_retirement"] == reserve["guard_retirement"]
             and proof["guard_retirement"]["path"] == str(COLD168_ROOT/"TERMINAL_GUARD_DRAINED.json")
             and proof["admission"] == reserve["admission"] and reserve["retained_cap_bytes"] == CAPS[168]
             and proof["resource_credit_bytes"] == reserve["resource_credit_bytes"] == reserve["reservation_ending_bytes"] == 0,
             "different cold168 retry4 commit, drain or retained booking")
        result[168]=proof
    return result

def validate(value,fleet,fr,tr,epoch=166,cold170=False,cold168=False):
    closed=closing(value,fleet,cold170,cold168)
    expected={row["unit"]["Id"] for group in ("actual_executing_replays","actual_active_bootstraps","actual_active_private_diagnostics") for row in fleet[group]}
    need(value["schema"]=="horizon-incident-replay-fit-v1" and value["epoch"]==145 and value["fleet"]==fr and value["fits"] and
         epoch in closed and tr==closed[epoch]["terminal"] and set(value["population"])==expected and
         value["complete_cpu_quota_micros"]==64000000 and value["complete_memory_plus_reserve_bytes"]==MEM and
         value["resource_credit_bytes"]==value["stopped_generation_resident_credit_bytes"]==0 and
         value["replay_launch_authorized"] is False and 0<=time.time()-value["recorded_unix_seconds"]<=180,
         "different joined reservation or population")
    prepaid = {str(e):PRESTART[e] for e in closed if e in PRESTART}
    if cold168 or cold170:
