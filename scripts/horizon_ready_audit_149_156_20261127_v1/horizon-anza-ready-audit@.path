[Unit]
Description=Watch Anza's local public audit admission for epoch %i
RequiresMountsFor=/var/lib/jetstreamer/horizon_runtime_data/ready-range-audit-20261121-v1/pool
ConditionPathExists=/var/lib/jetstreamer/horizon_runtime_data/ready-range-audit-20261121-v1/pool/anza-149-156/queue/epoch-%i.json

[Path]
PathChanged=/var/lib/jetstreamer/horizon_runtime_data/ready-range-audit-20261121-v1/pool/anza-149-156/jobs/%i/READY
Unit=horizon-anza-ready-audit@%i.service

[Install]
WantedBy=multi-user.target
