     #[test]
+    fn epoch231_native_restore_guard_requires_its_exact_ram_scope() {
+        let plan = json!({
+            "schema": "jetstreamer-horizon-standalone-guard-plan-v1",
+            "unit": "horizon-perf-epoch231-native-restore@v1.service",
+            "invocation_id": "a".repeat(32),
+            "filesystem": "/home/ubuntu/.jetstreamer-private/epoch231-native-restore-tmpfs-v1",
+            "worker_root": "/home/ubuntu/.jetstreamer-private/epoch231-native-restore-tmpfs-v1/run",
+            "receipt_directory": "/var/lib/jetstreamer/horizon231-native-restore-runtime-v1/guard-receipts",
+            "minimum_free_bytes": 2u64 << 30,
+            "maximum_root_physical_bytes": 128u64 << 30,
+            "maximum_worker_vmas": 3_500_000,
+        });
+        assert!(validate_plan(&serde_json::from_value(plan.clone()).unwrap()).is_ok());
+        for (field, value) in [
+            ("filesystem", json!("/")),
+            ("worker_root", json!("/tmp")),
+            ("maximum_root_physical_bytes", json!((128u64 << 30) + 1)),
+            ("minimum_free_bytes", json!((2u64 << 30) - 1)),
+        ] {
+            let mut changed = plan.clone();
+            changed[field] = value;
+            assert!(validate_plan(&serde_json::from_value(changed).unwrap()).is_err());
+        }
+    }
