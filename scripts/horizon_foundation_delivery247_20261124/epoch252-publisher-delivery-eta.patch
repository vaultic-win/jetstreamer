+def rate_estimate_252(length, sample, claim, observer):
+    owner = bound(claim)
+    assert owner['epoch'] == 252 and owner['unit'] == 'horizon-upload-252-current-reader-v1.service'
+    manager = props(owner['unit'], publisher_fields)
+    verify_publisher(owner, manager)
+    start = dt.datetime.strptime(manager['ExecMainStartTimestamp'], '%a %Y-%m-%d %H:%M:%S UTC')
+    started = start.replace(tzinfo=dt.timezone.utc).timestamp()
+    baseline = {'path': str(V/'horizon252-status-delivery-baseline-v1/timing.json'),
+                'sha256': '6d5803578f0863c7fc26d25db06b919a1c0f6889c28cbf7dd7650372dced91cd'}
+    measured = bound(baseline)
+    allowance = measured['delivery_allowance_millis'] // 1000
+    assert measured['epoch'] == 252 and allowance == 36000 and sample >= started
+    path = Path(claim['path']).parent/'operation.log'
+    with path.open('rb') as stream:
+        size = os.fstat(stream.fileno()).st_size
+        assert 0 < size < 64 << 20
+        log = stream.read(size)
+        assert len(log) == size
+    phase = 'verification'
+    for line in log.splitlines():
+        if not (line.startswith(b'{') and line.endswith(b'}') and b'"event":"r2-' in line):
+            continue
+        event = json.loads(line)
+        assert event['key'] == 'epoch-252.jet' and event['total_bytes'] == length
+        if event['event'].startswith('r2-upload-'):
+            phase = 'upload'
+        elif event['event'].startswith('r2-readback-'):
+            phase = 'verification' if event['event'] == 'r2-readback-verified' else 'readback'
+    remaining = math.ceil(started + allowance - sample)
+    basis = 'Ten-hour allowance from the publisher start, based on the measured complete deliveries of epochs 257 and 261.'
+    if remaining <= 0:
+        remaining = {'verification': 7200, 'upload': 14400, 'readback': 10800}[phase]
+        basis = 'The measured end-to-end allowance elapsed. This planning estimate covers the current phase and remaining delivery checks.'
+    return dict(phase=phase, eta=remaining, basis=basis, baseline=baseline, claim=claim,
+                observer=observer, publisher_started_utc=start.isoformat()+'Z',
+                log=dict(path=str(path), length=size, prefix_sha256=hashlib.sha256(log).hexdigest()))
+
