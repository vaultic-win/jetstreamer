+    fn epoch296_meter_guard_requires_the_exact_private_disk_scope() {
+        let plan = json!({
+            "schema": "jetstreamer-horizon-standalone-guard-plan-v1",
+            "unit": "horizon-perf-epoch296-meter-bounded@v3.service",
+            "invocation_id": "a".repeat(32),
+            "filesystem": "/",
+            "worker_root": "/home/ubuntu/.jetstreamer-private/qualification-296-meter-bounded-v3",
+            "receipt_directory": "/var/lib/jetstreamer/horizon296-meter-bounded-v3/guard-receipts",
+            "minimum_free_bytes": 3_770_104_987_645u64,
+            "maximum_root_physical_bytes": 128_347_983_872u64,
+            "maximum_worker_vmas": 3_500_000,
+        });
+        assert!(validate_plan(&serde_json::from_value(plan.clone()).unwrap()).is_ok());
+        for (key, change) in [
+            ("unit", json!("horizon-perf-epoch296-meter-bounded@other.service")),
+            ("filesystem", json!("/tmp")),
+            ("worker_root", json!("/home/ubuntu/.jetstreamer-private/other")),
+            ("receipt_directory", json!("/var/lib/jetstreamer/other")),
+            ("minimum_free_bytes", json!(3_770_104_987_644u64)),
+            ("maximum_root_physical_bytes", json!(128_347_983_873u64)),
+            ("maximum_worker_vmas", json!(3_500_001)),
+        ] {
+            let mut invalid = plan.clone();
+            invalid[key] = change;
+            assert!(validate_plan(&serde_json::from_value(invalid).unwrap()).is_err(), "{key}");
+        }
+    }
