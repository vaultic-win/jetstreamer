[Unit]
Description=Replay and verify the private epoch 226 checkpoint suffix

[Service]
Type=exec
User=ubuntu
Group=ubuntu
UMask=0077
Restart=no
KillMode=control-group
Delegate=no
AllowedCPUs=16-23
CPUAffinity=16-23
CPUQuota=800%
MemoryHigh=137438953472
MemoryMax=171798691840
MemorySwapMax=0
TasksMax=512
RuntimeMaxSec=14400
TimeoutStartSec=180
TimeoutStopSec=180
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/ubuntu/.jetstreamer-private/checkpoint-continuation-226-suffix-v1 /home/ubuntu/.jetstreamer-private/checkpoint-continuation-226.lock
ReadOnlyPaths=/var/lib/jetstreamer/horizon226-suffix-v1 /var/lib/jetstreamer/horizon226-suffix-stage-evidence-v1 /home/ubuntu/.jetstreamer-private/checkpoint-continuation-226-extract-v2/output
UnsetEnvironment=HORIZON_S3_ENDPOINT HORIZON_ACCESS_KEY_ID HORIZON_SECRET_ACCESS_KEY HORIZON_PUBLIC_BASE_URL JETSTREAMER_ROOT_COHORT_RESUME_RUN JETSTREAMER_EXPORT_HANDOFF_SNAPSHOT_DIR JETSTREAMER_LOAD_FROM_DIR JETSTREAMER_ADAPTIVE_EPOCH_CONCURRENCY
Environment=JETSTREAMER_ALLOW_CANDIDATE_RUNTIME=1
Environment=JETSTREAMER_HISTORICAL_WORKER_V1_6_25=/var/lib/jetstreamer/horizon-227-v1625-qualification-7a831420-v1/jetstreamer-historical-worker-v1-6-25
Environment=JETSTREAMER_ENFORCE_ARCHIVE_HASH=1
Environment=JETSTREAMER_VERIFY_SNAPSHOTS=1
Environment=JETSTREAMER_PRUNE_EPOCH_SNAPSHOTS=0
Environment=JETSTREAMER_NETWORK=mainnet
Environment=RUST_LOG=info
Environment=RUST_MIN_STACK=134217728
Environment=SOLANA_RAYON_THREADS=8
Environment=RAYON_NUM_THREADS=8
Environment=JETSTREAMER_HISTORICAL_POH_THREADS=8
Environment=JETSTREAMER_REPLAY_THREADS=8
Environment=TOKIO_WORKER_THREADS=8
ExecStart=/run/foundation-epoch226-release.y35rokj7/jetstreamer-node 226 /home/ubuntu/.jetstreamer-private/checkpoint-continuation-226-suffix-v1/ledger --verify --checkpoint-continuation-plan=/var/lib/jetstreamer/horizon226-suffix-v1/plan.json --checkpoint-continuation-plan-sha256=__PLAN_SHA256__
