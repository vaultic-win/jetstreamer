+        .context("epoch 185 native command framing")?;
+    ensure!(
+        !args.is_empty() && prefix == format!("{{ path={} ; argv[]={}", args[0], args.join(" ")),
+        "epoch 185 native command identity changed"
+    );
+    Ok(())
+}
