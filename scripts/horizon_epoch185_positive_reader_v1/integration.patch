+            output_path(root, &hash, None).unwrap()
+        );
+        assert!(output_path(root, &hash, Some("../foreign")).is_err());
+        assert!(output_path(root, &"A".repeat(64), Some(&iid)).is_err());
+        assert!(output_path(root, &hash, Some(&"c".repeat(31))).is_err());
+    }
+}
