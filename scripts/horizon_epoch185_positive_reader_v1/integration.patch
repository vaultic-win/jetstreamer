+struct Bus(*mut c_void);
+struct Message(*mut c_void);
+impl Drop for Bus {
+    fn drop(&mut self) {
+        unsafe {
+            sd_bus_unref(self.0);
+        }
+    }
+}
+impl Drop for Message {
+    fn drop(&mut self) {
+        unsafe {
+            sd_bus_message_unref(self.0);
+        }
+    }
