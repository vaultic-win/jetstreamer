+"""Extend the complete V17-derived host quote with one full epoch 146 booking."""
+import os
+from pathlib import Path
+import runpy
+import time
+from types import SimpleNamespace
+
+R = Path('/var/lib/jetstreamer/horizon_runtime_data')
+V17 = '6649f2c650fc7774ffa054947ac94a96f8d3f8aefc4e1f7d10abe82eda4a2315'
+V24 = '312d387a80ee5d8700acd180e2634938c80f15acc3d5efa056be026f767c1613'
+V25 = '7f5315920183929bcded395d6827dfc84eb9c08481e77d26f53da3329e470122'
+STATUS = R/'survivor172-cadence-20261122-v1'
+V25_SEAL = STATUS/'tools-cold168-retry5-failed166-v25-entry146/deployment-seal-receipt.json'
+READER_SHA = 'c3a870f2e1b73277ce75cfb35ff2a7436dbbd7dcfb3fe4ea2e08db5001d17fef'
+UNIT = 'horizon-qualify-146-full-local-20261126-v1.service'
+OLD_UNIT = 'horizon-146-full-local-qualification-20261124-v1.service'
+RUN = '/home/sol/.jetstreamer-private/epoch146-standard-lane-20261122-v1/full-local-v1'
+FIELD = 'current_full146'
+G = 1 << 30
+CAP = 288 * G
+RAM = 69 * G
+CPU = 7_250_000
+DONOR_CPU = 9_250_000
+CUSTODY_SHA = '6d98a2cee2fb725179c4e0620b8ee4ed46e8665f7e24417bf8392eab1d8b70ca'
+
+
+def read(s, ref):
+    return s.bound(ref, Path(ref['path']))
+
+
+def proposal(s, ref):
+    p = read(s, ref)
+    needed = {'schema', 'producer_cpu_quota_micros', 'epoch168_followup_cpu_quota_micros',
+              'epoch168_followup_memory_bytes', 'epoch168_followup_additive_home_bytes',
+              'reuse_ended_epoch168_compute'}
+    s.need(set(p) == needed and p['schema'] == 'horizon-epoch146-full-fit-proposal-v1'
+           and p['producer_cpu_quota_micros'] == 6_250_000
+           and p['reuse_ended_epoch168_compute'] is True
+           and all(type(p[k]) is int and p[k] >= 0 for k in
+                   ('epoch168_followup_cpu_quota_micros', 'epoch168_followup_memory_bytes',
+                    'epoch168_followup_additive_home_bytes'))
+           and bool(p['epoch168_followup_cpu_quota_micros']) == bool(p['epoch168_followup_memory_bytes']),
+           'invalid full 146 allocation proposal')
+    return p
+
+
+def fleet_roster(s, fleet, rows):
+    row = fleet.get(FIELD)
+    booked = [r for r in rows if r['epoch'] == 146]
+    if not row or row['phase'] == 'terminal':
+        s.need(not booked, 'unregistered active full 146 fleet row')
+        return rows
+    s.need(booked == [row] and row['actor']['producer_unit'] == row['unit']['Id'] == UNIT
+           and 'epoch146_bounded_entry_lease' not in fleet,
+           'full 146 roster overlaps or changed')
+    return [r for r in rows if r['epoch'] != 146]
+
+
+def writer(s, fit, status):
+    expected = s.ref(V25_SEAL, V25)
+    s.need(status['consumer_seal'] == expected, 'full 146 requires the sole V25 cadence')
+    seal = read(s, expected)
+    path = V25_SEAL.with_name('full146_status.py')
+    member, = (m for m in seal['members'] if m['name'] == path.name)
+    s.need(member['mode'] == '0444' and member['sha256'] == READER_SHA,
+           'different sealed full 146 native reader')
+    fit.binary(path, READER_SHA)
+    return runpy.run_path(str(path))
+
+
+def guard_service(s, route, timer_iid, plan):
+    timer = route['timer'](timer_iid)
+    u = route['show'](route['SERVICE'], ('Id', 'MemoryMax', 'MemorySwapMax',
+                                          'CPUQuotaPerSecUSec', 'TriggeredBy', 'ExecStart'))
+    s.need(u['Id'] == route['SERVICE'] and u['MemoryMax'] == str(G)
+           and u['MemorySwapMax'] == '0' and u['CPUQuotaPerSecUSec'] == '1s'
+           and u['TriggeredBy'] == route['TIMER']
+           and str(plan) in u['ExecStart'],
+           'full 146 guard service lost its meter, timer or exact plan')
+    return timer
+
+
+def inspect(s, fit, request, fleet_ref, fleet, status):
+    mode = request['mode']
+    s.need('epoch146_bounded_entry_lease' not in fleet and not fit.members(OLD_UNIT),
+           'bounded 146 is still live or booked')
+    route = writer(s, fit, status)
+    c = SimpleNamespace(fleet_ref=fleet_ref, fleet=fleet, entry146=None, sample_ref=fleet['observer'],
+                        cfg={'diagnostic_replays': []}, sample={'diagnostic_replays': []}, rows={})
+    row = route['observe'](c, None)
+    p = proposal(s, request['proposal'])
+    if mode == 'prestart':
+        s.need(row is None and request['guard'] is None, 'prestart requires an unoccupied full 146 booking')
+        return dict(mode=mode, proposal=p, processes=[], footprint=0, timers=None)
+    s.need(row and row['phase'] in (('held',) if mode == 'held' else ('bootstrap', 'worker')),
+           'full 146 native phase differs from the requested booking')
+    a = row['actor']
+    enrolled = read(s, row['enrollment'])
+    quote = read(s, enrolled['quote'])
+    s.need(quote['proposal'] == request['proposal'] and quote['fleet'] == enrolled['fleet']
+           and quote['fit']['fits'] is True and row['unit']['InvocationID'] == a['producer_invocation_id'],
+           'full 146 native generation did not inherit its exact paid proposal')
+    main = a['producer_pid']
+    actors = [(main, a['start_ticks'])]
+    if row.get('worker'):
+        child = row['worker']
+        actors.append((child['pid'], child['start_ticks']))
+    processes = []
+    for pid, ticks in actors:
+        st = (Path('/proc')/str(pid)/'exe').stat()
+        processes.append([pid, ticks, st.st_dev, st.st_ino])
+    protected = request['guard']
+    footprint, timers = 0, None
+    if protected:
+        plan = read(s, protected['plan'])
+        sample = read(s, protected['sample'])
+        profile = read(s, enrolled['profile'])
+        timer_iid = protected['timer_invocation_id']
+        limits = profile['guard']['properties']
+        s.need(plan['invocation_id'] == a['producer_invocation_id'] and all(plan[k] == limits[k] for k in limits)
+               and (mode == 'held' or row['guard_protection'] == protected['plan']
+                    and row['guard_timer']['InvocationID'] == timer_iid)
+               and 0 <= time.time() - sample['recorded_unix_seconds'] <= 120,
+               'full 146 guard sample or plan is stale or crosses invocation')
+        timers = guard_service(s, route, timer_iid, protected['plan']['path'])
+        oldest = a['worker_ready_unix_seconds']
+        if row.get('worker'):
+            boot, = (int(line.split()[1]) for line in Path('/proc/stat').read_text().splitlines()
+                     if line.startswith('btime '))
+            oldest = max(oldest, boot + child['start_ticks'] // os.sysconf('SC_CLK_TCK'))
+        route['sample_guard'](sample, a, profile, protected['plan'],
+                              row['worker']['pid'] if row.get('worker') else None, oldest)
+        footprint = sample['root_physical_observation']['conservative_physical_bytes']
+    else:
+        s.need(mode == 'held', 'released full 146 requires its exact current protective sample')
+    route['recheck'](row)
+    return dict(mode=mode, proposal=p, unit=UNIT, actor=a, enrollment=row['enrollment'],
+                quote=enrolled['quote'], profile=enrolled['profile'], processes=processes,
+                phase=row['phase'], footprint=footprint, timers=timers, guard=protected,
+                armed_floor=quote['pending_guard']['minimum_free_bytes'],
+                available_guard_bytes=sample['available_bytes'] if protected else None)
+
+
+def check_same(s, first, last):
+    s.need(first == last, 'full 146 native actor, cgroup, profile, or guard changed during quote')
+
+
+def project(s, native, state, request):
+    want = ('horizon-qualify-167-source-index-v3-20261122.service',
+            'horizon-qualify-170-full-metered-20261124-v1.service',
+            'horizon-qualify-172-full-half-core-20261120-v1.service')
+    live = state['mode'] != 'prestart'
+    expected = set(want) | ({UNIT} if live else set())
+    old = native['retry5_complete_booking']
+    terminal = native['focused168_retry6']
+    cost = native['epoch185_serial_cost']
+    custody = native['epoch185_lanel_holding']
+    s.need(set(native['population']) == expected
+           and all(len(native['population'][unit]) == 2 for unit in want)
+           and (not live or native['population'][UNIT] == [r[:2] for r in state['processes']])
+           and '146' not in native['bookings'] and native['bounded_qualification'] is None
+           and native['resource_credit_bytes'] == 0 and native['replay_launch_authorized'] is False
+           and native['complete_cpu_quota_micros'] == 64_000_000
+           and native['complete_memory_plus_reserve_bytes'] == 810_658_050_048
+           and old['funded'] is True and old['producer_cpu_quota_micros'] + old['guard_cpu_quota_micros'] == DONOR_CPU
+           and old['producer_memory_bytes'] + old['guard_memory_bytes'] == RAM
+           and old['candidate_remaining_bytes'] == terminal['paid']['remaining_bytes'] == native['bookings']['168']['remaining_bytes']
+           and terminal['terminal'] and terminal['processes'] == [] and terminal['resource_credit_bytes'] == 0
+           and cost['native_fleet'] == native['fleet'] and cost['required_home_bytes'] == native['complete_required_HOME_bytes']
+           and cost['serial_restore_enlargement_bytes'] == 54_016_054_271
+           and cost['metadata_allowance_bytes'] == 2_097_152 and cost['resource_credit_bytes'] == 0
+           and custody['observation']['custody']['sha256'] == CUSTODY_SHA
+           and custody['holding_reservation']['restore_overlap_bytes'] == 123_350_028_052,
+           'V17 incumbent population, ended donor or 168/185 custody changed')
+    p = state['proposal']
+    follow_cpu = p['epoch168_followup_cpu_quota_micros']
+    follow_ram = p['epoch168_followup_memory_bytes']
+    follow_home = p['epoch168_followup_additive_home_bytes']
