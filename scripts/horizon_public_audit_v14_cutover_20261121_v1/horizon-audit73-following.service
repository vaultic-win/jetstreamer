[Unit]
Description=Wait for the public reader to exit and transfer the sole audit supervisor
After=network-online.target
ConditionPathExists=!/var/lib/jetstreamer/horizon_runtime_data/public-audit73-observer-20261121-v1/PUBLIC_OWNER.json
RequiresMountsFor=/var/lib/jetstreamer/horizon_runtime_data/public-audit73-observer-20261121-v1

[Service]
Type=exec
Slice=horizonaudit.slice
User=root
UMask=0077
WorkingDirectory=/var/lib/jetstreamer/horizon_runtime_data/public-audit73-observer-20261121-v1
ExecStart=/usr/bin/python3 -IB /var/lib/jetstreamer/horizon_runtime_data/public-audit73-observer-20261121-v1/following-package-v2/follow_boundary.py watch
ExecStopPost=/usr/bin/python3 -IB /var/lib/jetstreamer/horizon_runtime_data/public-audit73-observer-20261121-v1/following-package-v2/follow_boundary.py recover
TimeoutStartSec=30
TimeoutStopSec=110
CPUQuota=100%
MemoryMax=256M
MemorySwapMax=0
TasksMax=24
Nice=10
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
