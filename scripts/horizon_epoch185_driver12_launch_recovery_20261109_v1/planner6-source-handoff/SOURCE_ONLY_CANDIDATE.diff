+#[cfg(test)] mod current_driver12_template_regression {
+ use super::*;
+ fn profile()->Profile{Profile{purpose:Purpose::BoundedNativeProbe,actor_memory_bytes:48u64<<30,setup_deadline_seconds:600,useful_runtime_seconds:14400,estimated_useful_work_millis:413404206}}
+ #[test] fn current_driver12_pair_is_exact_and_historical_driver11_stays_unchanged() {
+  let old=templates(&profile(),5174779130516,"driver-pair-regression").unwrap();
+  let new=current_templates(&profile(),5174779130516,"driver-pair-regression").unwrap();
+  assert_eq!(old["envelope"]["self_program"],"/usr/local/lib/jetstreamer/horizon-epoch185-guarded-adapter-v11/epoch185-guarded-cold");
+  assert_eq!(old["envelope"]["self_sha256"],"bdadc547439d2dbba11797f715c1741772dad693cd54073ac273132a7ba096f2");
+  assert_eq!(new["envelope"]["self_program"],CURRENT_DRIVER_PATH);assert_eq!(new["envelope"]["self_sha256"],CURRENT_DRIVER_SHA);
+  for (field,count) in [("actor",2),("guard",1)] {
+   let text=new[field].as_str().unwrap();assert_eq!(text.matches(CURRENT_DRIVER_PATH).count(),count);assert_eq!(text.matches(CURRENT_DRIVER_SHA).count(),count);
+   assert!(!text.contains("guarded-adapter-v11"));assert!(!text.contains("bdadc547"));
+  }
+  // Revert only the explicit driver selectors and demand exact whole-result
+  // equality: floors, caps, clocks, all templates and authority must be intact.
+  let mut reversed=new.clone();reversed["envelope"]["self_program"]=old["envelope"]["self_program"].clone();reversed["envelope"]["self_sha256"]=old["envelope"]["self_sha256"].clone();
+  for field in ["actor","guard"] {
+   reversed[field]=json!(new[field].as_str().unwrap().replace(CURRENT_DRIVER_PATH,old["envelope"]["self_program"].as_str().unwrap()).replace(CURRENT_DRIVER_SHA,old["envelope"]["self_sha256"].as_str().unwrap()));
+  }
+  assert_eq!(reversed,old);
+  assert_eq!(new["envelope"]["plan"]["terminal_slot"],80351283);assert_eq!(new["envelope"]["limits"]["memory"],48u64<<30);
+  assert_eq!(new["envelope"]["setup_deadline_seconds"],600);assert_eq!(new["admission"]["ordinary_full_replay_authorized"],false);
+  assert_eq!(new["issued_at_or_expiry_materialized"],false);assert_eq!(new["normal_seal_or_admission_issued"],false);
+  let timer=new["timer"].as_str().unwrap();let sha=storage::sha(timer.as_bytes());
+  assert_eq!(new["envelope"]["timer_service"]["sha256"],sha);assert_eq!(new["task_capture_spec"]["native_spec"]["timer_source"]["sha256"],sha);
+ }
