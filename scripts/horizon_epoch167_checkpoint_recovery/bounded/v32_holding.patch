+fn registered32(q: &Value) -> Result<bool> {
+    let binding = &q["v32_cadence"];
+    let previous = &q["v31_cadence"];
+    let status = &q["status_registration"];
+    if binding["schema"] != "horizon-v32-joint168-capacity-generation-v1"
+        || binding["cadence_seal"] != status["consumer_seal"]
+        || binding["predecessor"] != previous["cadence_seal"]
+        || previous["cadence_seal"]["path"] != CADENCE31
+        || previous["active"]["path"] != ACTIVE31
+        || previous["ready"]["path"] != READY31
+        || binding["active"]["path"] != ACTIVE32
+        || binding["ready"]["path"] != READY32
+        || !retained167(q)?
+        || !retained170(q)?
+    {
+        return Ok(false);
+    }
+    let active = read_bound(&binding["active"])?;
+    let ready = read_bound(&binding["ready"])?;
+    let predecessor = read_bound(&previous["active"])?;
+    let predecessor_ready = read_bound(&previous["ready"])?;
+    Ok(same_registered32(
+        q,
+        &active,
+        &ready,
+        &predecessor,
+        &predecessor_ready,
+    ))
+}
+
+fn same_registered32(
+    q: &Value,
+    active: &Value,
+    ready: &Value,
+    predecessor: &Value,
+    predecessor_ready: &Value,
+) -> bool {
+    let binding = &q["v32_cadence"];
+    let previous = &q["v31_cadence"];
+    let status = &q["status_registration"];
+    let actor = &active["new"];
+    active["ready"] == binding["ready"]
+        && active["producer_mutations"] == false
+        && ready["old_owner"] == previous["active"]
+        && active["old"] == predecessor["new"]
+        && predecessor["ready"] == previous["ready"]
+        && predecessor_ready["package"] == previous["cadence_seal"]
+        && ready["package"] == binding["cadence_seal"]
+        && ready["full170_terminal"] == q["retained_170"]["terminal"]
+        && ready["full170_terminal"] == predecessor_ready["full170_terminal"]
+        && ["invocation_id", "pid", "start_ticks"]
+            .iter()
+            .all(|key| actor[*key] == status[*key])
+}
