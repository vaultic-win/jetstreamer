+def request_args(s, lane, ref):
+    request = lane['read'](s, ref)
+    s.need(request.get('mode') == 'terminal' and request.get('guard') is None
+           and set(request) == {'schema','mode','retirement','growth_bytes','stop_allowance_bytes',
+                                'enrollment','guard','terminal','compute_release'}
+           and request['compute_release'] in (None, dict(unit=COMPARATOR, invocation_id=COMPARATOR_IID)),
+           'terminal joint 168 requires exact closure and a scoped compute settlement')
+    original = dict(request, mode='active')
+    original.pop('terminal')
+    s.need(original['schema'] == lane['REQUEST_SCHEMA']
+           and all(type(original[key]) is int and 0 < original[key] < 1 << 64
+                   for key in ('growth_bytes','stop_allowance_bytes'))
+           and original['enrollment'] is not None, 'invalid retained joint 168 request')
+    return request
+
+
+def native_exit(s, unit, actor, terminal):
+    identity = actor['invocation_id']
+    journal = terminal['pid1_terminal_event']
+    event_id = journal['MESSAGE_ID']
+    boot = actor['boot_id'].replace('-', '')
+    s.need((terminal['disposition'] == 'checkpoint-complete' and event_id == SUCCESS
+            and terminal['independent_archive_scan_pending'] is True)
+           or (terminal['disposition'] == 'failed' and event_id == FAILURE
+               and journal['COMMAND'] == 'ExecStart' and str(journal['EXIT_STATUS']) != '0'),
+           'joint 168 lacks its exact checkpoint or native failure outcome')
+    selectors = ('_PID=1', '_UID=0', '_BOOT_ID='+boot, 'UNIT='+unit,
+                 'INVOCATION_ID='+identity, 'MESSAGE_ID='+event_id)
+    result = subprocess.check_output(['/usr/bin/journalctl','--quiet','--no-pager','--all','--output=json',*selectors],
+                                     text=True, timeout=15)
+    matched = [json.loads(line) for line in result.splitlines()]
+    s.need(len(matched) == 1 and matched[0] == journal
+           and int(journal['__REALTIME_TIMESTAMP']) >= actor['ready_at']*1_000_000,
+           'joint 168 closure did not match the native PID1 event')
+
+
+def comparator(s, lane, terminal):
+    from owners import ticks
+
+    tools = lane['ROOT']/'continuity-tools'
+    program = tools/'horizon-168-joint-compare'
+    seal_ref = s.ref(tools/'deployment-seal-receipt.json', COMPARATOR_SEAL)
+    seal = s.bound(seal_ref, tools/'deployment-seal-receipt.json')
+    s.need(seal['destination'] == str(tools) and any(
+        row['name'] == program.name and row['mode'] == '0555' and row['sha256'] == COMPARATOR_SHA
+        for row in seal['members']), 'foreign terminal epoch 168 comparator seal')
+    fields = ('Id','InvocationID','ActiveState','SubState','MainPID','ControlPID','ControlGroup','Job',
+              'Restart','NRestarts','MemoryMax','MemorySwapMax','CPUQuotaPerSecUSec')
+    status = lane['props'](COMPARATOR, fields)
+    units = subprocess.check_output(
+        ['/usr/bin/systemctl','list-units','--type=service','--state=activating,active,deactivating',
+         '--no-legend','--plain','--no-pager','horizon-168-joint-continuity-*.service'],
+        text=True, timeout=12)
+    active = [line.split()[0] for line in units.splitlines() if line.strip()]
+    group = '/system.slice/'+COMPARATOR
+    cgroup = Path('/sys/fs/cgroup')/group.lstrip('/')
+    expected = [str(program),'--compare-joint',terminal['archive_sha256']]
+    if status['ActiveState'] == 'active':
+        pid = int(status['MainPID'])
+        proc = Path('/proc')/str(pid)
+        start = ticks(pid)
+        s.need(active == [COMPARATOR] and status['Id'] == COMPARATOR
+               and status['InvocationID'] == COMPARATOR_IID and status['SubState'] == 'running'
+               and status['ControlPID'] == '0' and not status['Job'] and status['ControlGroup'] == group
+               and status['Restart'] == 'no' and status['NRestarts'] == '0'
+               and status['MemoryMax'] == str(2*GIB) and status['MemorySwapMax'] == '0'
+               and status['CPUQuotaPerSecUSec'] == '1s' and lane['cgroup_limits'](cgroup,1_000_000,2*GIB)
+               and lane['process_members'](cgroup) == {pid}
+               and (proc/'cgroup').read_text().strip() == '0::'+group
+               and (proc/'exe').samefile(program) and lane['sha'](proc/'exe') == COMPARATOR_SHA
+               and lane['proc_argv'](proc) == expected and ticks(pid) == start
+               and lane['props'](COMPARATOR,fields) == status,
+               'terminal epoch 168 comparator crossed its identity, budget or executable')
+        return dict(unit=COMPARATOR,invocation_id=COMPARATOR_IID,pid=pid,start_ticks=start,
+                    seal=seal_ref,phase='active',memory_bytes=2*GIB,cpu_quota_micros=1_000_000)
+    selectors = ('_PID=1','UNIT='+COMPARATOR,'INVOCATION_ID='+COMPARATOR_IID,'MESSAGE_ID='+SUCCESS)
+    result = subprocess.check_output(
+        ['/usr/bin/journalctl','--quiet','--no-pager','--all','--output=json',*selectors],
+        text=True, timeout=12)
+    exits = [json.loads(line) for line in result.splitlines()]
+    s.need(status['Id'] == COMPARATOR and status['ActiveState'] == 'inactive'
+           and status['InvocationID'] in ('',COMPARATOR_IID) and not status['Job']
+           and all(status.get(name,'0') == '0' for name in ('MainPID','ControlPID'))
+           and not active and not lane['process_members'](cgroup) and len(exits) == 1
+           and int(exits[0]['__REALTIME_TIMESTAMP']) >= int(terminal['pid1_terminal_event']['__REALTIME_TIMESTAMP'])
+           and lane['props'](COMPARATOR,fields) == status,
+           'terminal epoch 168 comparator has no exact active or drained generation')
+    return dict(unit=COMPARATOR,invocation_id=COMPARATOR_IID,phase='complete',seal=seal_ref,
+                terminal_event=exits[0],memory_bytes=2*GIB,cpu_quota_micros=1_000_000)
+
+
+def observe_selector(s, lane, witness):
+    from owners import ticks
+
+    root = lane['ROOT'].parent/'epoch168-retry4-selected-prefix-20261127-v1'
+    unit = 'horizon-168-retry4-selected-prefix-20261127-v1.service'
+    group = '/system.slice/'+unit
+    cgroup = Path('/sys/fs/cgroup')/group.lstrip('/')
+    fields = ('Id','InvocationID','ActiveState','SubState','MainPID','ControlPID','ControlGroup',
+              'Job','Restart','NRestarts','MemoryMax','MemorySwapMax','CPUQuotaPerSecUSec',
+              'ProtectHome','ProtectSystem','PrivateNetwork')
+    status = lane['props'](unit, fields)
+    if status['ActiveState'] in ('inactive', 'failed'):
+        s.need(status['Id'] == unit and not status['Job'] and not lane['process_members'](cgroup)
+               and all(status.get(key, '0') in ('','0') for key in ('MainPID','ControlPID'))
+               and lane['props'](unit, fields) == status, 'epoch 168 selector is not drained')
+        return None
+
+    active_ref = s.ref(root/'ACTIVE.json','f32a20461b7e4c524ffbb6d7de86288516114c2bea6020c710ca0642e2ba1b26')
+    active = s.bound(active_ref, root/'ACTIVE.json')
+    intent = s.bound(active['intent'], root/'START_INTENT.json')
+    fit = s.bound(active['fit'], root/'FIT.json')
+    program = root/'tools/horizon-168-retry4-select'
+    seal_path = program.with_name('deployment-seal-receipt.json')
+    seal = s.bound(intent['deployment'], seal_path)
+    expected_sha = intent['executable']['sha256']
+    s.need(seal['destination'] == str(program.parent)
+           and intent['executable']['path'] == str(program) and intent['fit'] == active['fit']
+           and any(row['name'] == program.name and row['mode'] == '0555'
+                   and row['sha256'] == expected_sha for row in seal['members'])
+           and witness is not None and witness['phase'] == 'complete'
+           and fit['comparator_terminal'] == witness['terminal_event']
+           and fit['overlapping_comparator'] is fit['publishes'] is False
+           and fit['archive_bytes_written'] == fit['swap_bytes'] == 0
+           and fit['memory_reserved_bytes'] == fit['independently_charged_additional_memory_bytes'] == 4*GIB
+           and fit['preserved_epoch168_comparator_cpu_quota_micros'] == 1_000_000
+           and fit['evidence_disk_allowance'] == 16 << 20,
+           'epoch 168 selector lacks its exact separate charge and drained comparator evidence')
+    pid = int(status['MainPID'])
+    proc = Path('/proc')/str(pid)
+    s.need(pid > 1 and active['pid'] == pid and ticks(pid) == active['start_ticks']
+           and active['unit'] == status['Id'] == unit
+           and active['invocation_id'] == status['InvocationID']
+           and status['ActiveState'] == 'active' and status['SubState'] == 'running'
+           and status['ControlPID'] == '0' and not status['Job'] and status['ControlGroup'] == group
+           and status['Restart'] == 'no' and status['NRestarts'] == '0'
+           and status['MemoryMax'] == str(4*GIB) and status['MemorySwapMax'] == '0'
+           and status['CPUQuotaPerSecUSec'] == '1s'
+           and status['ProtectHome'] == 'read-only' and status['ProtectSystem'] == 'strict'
+           and status['PrivateNetwork'] == 'yes' and lane['cgroup_limits'](cgroup,1_000_000,4*GIB)
+           and lane['process_members'](cgroup) == {pid}
+           and (proc/'cgroup').read_text().strip() == '0::'+group
+           and (proc/'exe').samefile(program) and lane['sha'](proc/'exe') == expected_sha
+           and lane['proc_argv'](proc) == [str(program),'--select-retry4-prefix']
+           and ticks(pid) == active['start_ticks'] and lane['props'](unit,fields) == status,
+           'epoch 168 selector crossed its native invocation, executable, or admitted limits')
+    return dict(unit=unit, invocation_id=active['invocation_id'], pid=pid,
+                start_ticks=active['start_ticks'], active=active_ref, memory_bytes=4*GIB,
+                cpu_quota_micros=1_000_000, evidence_disk_bytes=fit['evidence_disk_allowance'])
+
+
+def settle_compute(s, combined, candidate):
+    witness = candidate['settled_compute']
+    if witness is None:
+        return combined
+    paid = combined['joint168']
+    terminal = candidate['terminal']
+    fit = combined['fit']
+    incumbent = combined['full146']['fit']
+    stopped_memory = paid['producer_memory_bytes']+paid['guard_memory_bytes']
+    stopped_cpu = paid['producer_cpu_quota_micros']+paid['guard_cpu_quota_micros']
+    released_memory = stopped_memory-witness['memory_bytes']
+    released_cpu = stopped_cpu-witness['cpu_quota_micros']
+    s.need(combined['mode'] == candidate['mode'] == 'terminal' and not candidate['processes']
+           and stopped_memory == 60*GIB and stopped_cpu == 2_000_000
+           and released_memory == 58*GIB and released_cpu == 1_000_000
+           and fit['required_available_memory_bytes'] == incumbent['existing_required_memory_bytes']+stopped_memory
+           and fit['extra_memory_bytes'] == 52*GIB,
+           'different paid epoch 168 compute at terminal')
+    selector = candidate['active_selector']
+    if selector is not None:
+        released_memory -= selector['memory_bytes']
+        released_cpu -= selector['cpu_quota_micros']
+        required_home = fit['required_home_bytes']+selector['evidence_disk_bytes']
+        fit.update(required_home_bytes=required_home,
+                   home_shortfall_bytes=max(0,required_home-fit['available_home_bytes']))
+    required = fit['required_available_memory_bytes']-released_memory
+    available = fit['available_memory_bytes']
+    fit.update(required_available_memory_bytes=required,memory_shortfall_bytes=max(0,required-available))
+    combined['terminal168_compute_settlement'] = dict(
+        terminal=terminal, comparator=witness, active_selector=selector,
+        replaced_168_memory_bytes=stopped_memory,
+        replaced_168_cpu_quota_micros=stopped_cpu, released_memory_bytes=released_memory,
+        released_cpu_quota_micros=released_cpu, preserved_comparator_memory_bytes=witness['memory_bytes'],
+        preserved_comparator_cpu_quota_micros=witness['cpu_quota_micros'],
+        effective_complete_cpu_quota_micros=incumbent['projected_cpu_quota_micros']-released_cpu,
+        source_scope_epoch=167, other_operation_can_reuse=False, disk_reservation_ending_bytes=0,
+        stopped_generation_resident_credit_bytes=0)
+    return combined
+
+
+def inspect(s, lane, request, incumbent, status, fleet, tree_size, *, measured=None):
+    rr = lane['retirement'](s, request['retirement'])
+    enrollment, quote = lane['enrollment'](s, request['enrollment'], request, incumbent, status)
+    lane['load_payload'](s, enrollment, quote)
+    actor = enrollment['actor']
+    row = fleet[lane['FIELD']]
+    ref = request['terminal']
+    terminal = s.bound(ref, lane['ROOT']/'TERMINAL.json')
+    unit = lane['UNIT']
+    s.need(row['enrollment'] == request['enrollment'] and row['prestart'] == enrollment['prestart_quote']
+           and row['unit']['Id'] == unit
+           and row['actor']['producer_invocation_id'] == actor['invocation_id']
+           and row['actor']['producer_pid'] == terminal['producer_pid'] == actor['pid']
+           and row['actor']['producer_start_ticks'] == terminal['producer_start_ticks'] == actor['start_ticks']
+           and row['actor']['boot_id'] == actor['boot_id']
+           and row['resource_credit_bytes'] == terminal['resource_credit_bytes'] == 0
+           and row['archive_publication_authorized'] is terminal['archive_publication_authorized'] is False
+           and terminal['schema'] == 'horizon-epoch168-joint-reduced-terminal-v1'
+           and terminal['enrollment'] == request['enrollment']
+           and terminal['producer_invocation_id'] == actor['invocation_id']
+           and terminal['private_output_preserved'] is True and terminal['remote_mutations'] is False,
+           'terminal joint 168 differs from the sole cadence roster or paid generation')
+    census = [(name, item)
+              for name in ('actual_executing_replays','actual_active_bootstraps','actual_active_private_diagnostics')
+              for item in fleet[name] if item['unit']['Id'] == unit]
+    if row['phase'] == 'terminal':
+        s.need(row['terminal'] == ref and not census,
+               'terminal joint 168 differs from the accepted stopped census')
+    else:
+        release = s.bound(row['release'], lane['RELEASE'])
+        guard = row['guard']
+        plan = lane['read'](s, guard['plan'])
+        sample = lane['read'](s, guard['sample'])
+        native_time = int(terminal['pid1_terminal_event']['__REALTIME_TIMESTAMP'])
+        s.need(row['phase'] == 'worker' and census == [('actual_active_private_diagnostics', row)]
+               and row['unit']['InvocationID'] == actor['invocation_id']
+               and release['enrollment'] == request['enrollment']
+               and release['producer_invocation_id'] == actor['invocation_id']
+               and plan['invocation_id'] == sample['producer_invocation_id'] == actor['invocation_id']
+               and plan['minimum_free_bytes'] == guard['floor'] == quote['joint168']['guard_floor_bytes']
+               and plan['maximum_root_physical_bytes'] == quote['joint168']['whole_tree_cap_bytes']
+               and sample['plan_sha256'] == guard['plan']['sha256']
+               and sample['producer_stop_enabled'] is True and sample['trip_reason'] is None
+               and [worker[0] for worker in sample['workers']] == [row['worker']['pid']]
+               and max(fleet['recorded_unix_seconds'],sample['recorded_unix_seconds'])*1_000_000 < native_time,
+               'native joint 168 exit did not follow the last accepted protected worker')
+    native_exit(s, unit, actor, terminal)
+    lane['require_idle'](s)
+    if measured is None:
+        root = lane['LANE']
+        cap = quote['joint168']['whole_tree_cap_bytes']
+        measured = tree_size(root, cap)
+        s.need(measured == tree_size(root, cap), 'terminal joint 168 paid tree changed between complete scans')
+    s.need(0 < measured <= quote['joint168']['whole_tree_cap_bytes'], 'terminal joint 168 exceeds paid whole-tree cap')
+    witness = None if request['compute_release'] is None else comparator(s, lane, terminal)
+    selector = observe_selector(s, lane, witness)
+    lane['require_idle'](s)
+    return dict(mode='terminal', retirement=rr, physical=measured, processes=[], worker=None,
+                unit=row['unit'], release=None, actor=actor, terminal=ref, fleet_phase=row['phase'],
+                settled_compute=witness, active_selector=selector,
+                enrollment=request['enrollment'], prestart=enrollment['prestart_quote'],
+                first_fit=quote['joint168'], guard=None, reservation_ending_bytes=0,
+                resource_credit_bytes=0, **lane['availability']())
