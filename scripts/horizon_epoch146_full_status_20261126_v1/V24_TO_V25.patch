+def log_identity(e, proc=None):
+    m = LOG.lstat()
+    binding = {'path': str(LOG), 'device': m.st_dev, 'inode': m.st_ino}
+    need(binding == e['append_log'] and stat.S_ISREG(m.st_mode) and m.st_uid == 0
+         and m.st_nlink == 1 and m.st_mode & 0o077 == 0 and LOG.resolve() == LOG,
+         'different full 146 append log')
+    if proc is not None:
+        for fd in ('1', '2'):
+            flags = dict(line.split(':', 1) for line in (proc/'fdinfo'/fd).read_text().splitlines())
+            need((proc/'fd'/fd).samefile(LOG) and int(flags['flags'], 8) & os.O_APPEND,
+                 'full 146 stdout is outside the bound append log')
+    with LOG.open('rb') as f:
+        m = os.fstat(f.fileno())
+        need((m.st_dev, m.st_ino) == (binding['device'], binding['inode']),
+             'full 146 append log changed while opening')
+        events = [json.loads(line) for line in f.read(16384).splitlines()
+                  if line.startswith(b'{') and b'"phase":"worker-ready"' in line]
+    a = e['actor']
+    expected = dict(phase='worker-ready', epoch=EPOCH, producer_invocation_id=a['producer_invocation_id'],
+                    producer_pid=a['producer_pid'], producer_start_ticks=a['start_ticks'],
+                    worker_ready_unix_seconds=a['worker_ready_unix_seconds'], profile_sha256=a['profile_sha256'])
+    need(events == [expected], 'full 146 log lacks the unique worker-ready event')
+    return binding
