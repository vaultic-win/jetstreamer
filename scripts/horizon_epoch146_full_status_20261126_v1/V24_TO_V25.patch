+def native(unit, a, e, profile, pids):
+    iid, pid = a['producer_invocation_id'], a['producer_pid']
+    proc = Path('/proc') / str(pid)
+    need(unit['Id'] == UNIT and unit['InvocationID'] == iid and unit['MainPID'] == str(pid)
+         and unit['ActiveState'] == 'active' and unit['SubState'] == 'running'
+         and unit['ControlGroup'] == GROUP and unit['NRestarts'] == '0' and not unit['Job']
+         and unit['ControlPID'] == '0' and unit['Restart'] == 'no' and unit['KillMode'] == 'control-group'
+         and unit['MemoryMax'] == str(68 << 30)
+         and unit['MemorySwapMax'] == '0' and pid in pids and 1 <= len(pids) <= 2
+         and ticks(pid) == a['start_ticks'] and (proc/'cgroup').read_text().strip() == '0::'+GROUP,
+         'full 146 PID1, cgroup, or retained limits changed')
+    cg = Path('/sys/fs/cgroup')/GROUP.lstrip('/')
+    quota, period = map(int, (cg/'cpu.max').read_text().split())
+    need(quota * 4 == period * 25 and (cg/'memory.max').read_text().strip() == str(68 << 30)
+         and (cg/'memory.swap.max').read_text().strip() == '0',
+         'full 146 effective CPU, memory or swap cap changed')
+    projected = proc/'root'/ALIAS.relative_to('/')/'payload.json'
+    need(projected.samefile(e['profile']['path']), 'full 146 projected profile inode changed')
+    if (proc/'exe').samefile(HOLD):
+        need(pids == {pid} and argv(proc) == [str(ALIAS/'held-producer'), e['profile']['sha256']],
+             'full 146 held launcher or sole cgroup member changed')
+        return proc, 'held'
+    need((proc/'exe').samefile(NODE) and image_digest(proc/'exe') == NODE_SHA
+         and argv(proc) == profile['native_argv'], 'full 146 release changed native node or argv')
+    return proc, 'bootstrap'
