+def forecast(c, prior, old, delivery, observed_archive):
+    row = c.full146
+    a = row['actor']
+    last = row.get('progress', {}).get('last')
+    age = round((c.now-utc(prior['sampled_at_utc'])).total_seconds()*1000)
+    need(age >= 0, 'full 146 sample predates the previous status')
+    archive = observed_archive(c, EPOCH) if row['phase'] == 'worker' else None
+    size = archive['size'] if archive else prior['jet_size_bytes']
+    need(size >= prior['jet_size_bytes'], 'full 146 archive length regressed')
+    tail = delivery(c, EPOCH, size)
+    measured = row['measured_progress']
+    need(not measured or archive is not None, 'measured full 146 work lacks its open archive')
+    worked = row.get('progress') or {}
+    if row['phase'] == 'terminal':
+        terminal_age = round((c.now-utc(row['terminal_forecast_at_utc'])).total_seconds()*1000)
+        need(terminal_age >= 0, 'terminal forecast follows the coordinated sample')
+        remaining = row['remaining_to_sidecar_millis'] - terminal_age
+        need(remaining > 0, 'full 146 terminal requires a current repair or verified delivery estimate')
+        phase = 'verification'
+        model = 'Root repair or local acceptance projection bound to the terminal receipt.'
+    elif measured and last:
+        need(63054847 <= last['slot'] <= END and worked['transaction_delta'] > 0,
+             'full 146 measured slot beyond the exact native replay domain')
+        remaining = round((END-last['slot'])*worked['elapsed_seconds']*1100/worked['slot_delta']) + tail['total_millis']
+        phase = 'replay' if last['slot'] < END else 'verification'
+        model = 'Same-worker observed slot rate with ten percent allowance, plus verified delivery.'
+    else:
+        ready = old['after_status']['estimated_remaining_millis']-age
+        remaining = ready if ready > tail['total_millis'] else tail['total_millis'] + 1800000
+        phase = 'replay' if row['phase'] == 'worker' and prior['phase'] == 'replay' else 'verification'
+        model = 'Retain the authenticated estimate until it reaches the evidence-backed delivery tail, then allow one cycle for replay reassessment.'
+    execution = prior['elapsed_execution_millis'] + age
+    after = dict(prior, sampled_at_utc=c.stamp, phase=phase, elapsed_execution_millis=execution,
+                 estimated_remaining_millis=remaining, jet_size_bytes=size)
+    extra = dict(archive_sample=archive, full146_enrollment=row['enrollment'], full146_observation=row, delivery_forecast=tail,
+                 estimate_model=model, measured_canonical_progress=measured,
+                 producer_invocation_id=None if row['phase'] == 'terminal' else a['producer_invocation_id'],
+                 current_repair_owner='/root' if row['phase'] == 'terminal' else None)
+    return after, extra
+
+
+def publish_initial(c, intent, store, body):
+    """Apply one authenticated conditional create for the already enrolled actor."""
+    setup = enrollment(c)
+    need(setup is not None, 'no full 146 enrollment for initial publication')
+    ref, e, profile = setup
+    request = sealed_doc(intent)
+    a = e['actor']
+    forecast = request['forecast']
+    payload = request['status']
+    when = int(utc(payload['sampled_at_utc']).timestamp())
+    need(request['schema'] == 'horizon-epoch146-full-initial-status-intent-v1'
+         and request['enrollment'] == ref and request['owner'] == '/root'
+         and set(payload) == {'epoch', 'phase', 'jet_size_bytes', 'elapsed_execution_millis',
+                              'sampled_at_utc', 'estimated_remaining_millis'}
+         and payload['epoch'] == EPOCH and payload['phase'] == 'verification'
+         and payload['jet_size_bytes'] == 0 and type(payload['elapsed_execution_millis']) is int
+         and payload['elapsed_execution_millis'] >= 0
+         and type(payload['estimated_remaining_millis']) is int and payload['estimated_remaining_millis'] > 0
+         and a['worker_ready_unix_seconds'] <= when <= a['worker_ready_unix_seconds'] + 320
+         and isinstance(forecast, str) and forecast.strip()
+         and e['fleet'] == c.fleet_ref and 'epoch146_bounded_entry_lease' not in c.fleet,
+         'foreign initial full 146 status or forecast')
+    snapshots = show(CONTROLLER, ('Id', 'ActiveState', 'InvocationID', 'MainPID', 'Job'))
+    successor = checked(e['writer'])['new']
+    need(snapshots['ActiveState'] == 'active' and snapshots['Id'] == successor['unit']
+         and snapshots['InvocationID'] == successor['invocation_id']
+         and snapshots['MainPID'] == str(successor['pid']) and not snapshots['Job']
+         and ticks(successor['pid']) == successor['start_ticks'],
+         'initial full 146 status requires the live sole V25 writer')
+    unit = show(UNIT, UNIT_FIELDS)
+    proc, phase = native(unit, a, e, profile, group_pids(UNIT))
+    log_identity(e, proc)
+    need(phase == 'held', 'initial full 146 status must precede protected release')
+    raw = body(payload)
+    pending = ROOT/'FULL146_INITIAL_STATUS_PENDING.json'
+    listed, ready, archives = store.inventory()
+    need(EPOCH not in ready and EPOCH not in archives, 'full 146 already has a canonical remote archive')
+    proof = dict(schema='horizon-epoch146-full-initial-status-v1', epoch=EPOCH, key=KEY,
+                 conditional_header='If-None-Match', previous_receipt=None, full146_enrollment=ref,
+                 producer_invocation_id=a['producer_invocation_id'], after_status=payload,
+                 after_sha256=hashlib.sha256(raw).hexdigest(), operator_intent=intent,
+                 writer=e['writer'], fleet_predecessor=c.fleet_ref, estimate_model=forecast,
+                 archive_publication_authorized=False, replay_launch_authorized=False)
+    if not pending.exists():
+        need(EPOCH not in listed and not INITIAL.exists(), 'epoch 146 status already exists without this intent')
+    durable(pending, proof)
+    put_etag = None
+    if EPOCH not in listed:
+        need(not INITIAL.exists(), 'published epoch 146 status disappeared')
+        # Storage already verifies the exact PUT target before signing. Add the creation
+        # precondition in the same event, replacing its default existing-object condition.
+        def if_absent(request, **_):
+            need(store.pending == (KEY, '*') and request.headers['If-Match'] == '*',
+                 'unexpected conditional full 146 creation')
+            del request.headers['If-Match']
+            request.headers['If-None-Match'] = '*'
+        store.s3.meta.events.register_last('before-sign.s3.PutObject', if_absent)
+        put_etag = store.put(EPOCH, '*', raw)
+    etag, observed = store.get(EPOCH)
+    need(observed == raw and (put_etag is None or put_etag == etag) and bool(etag),
+         'initial full 146 status changed during authenticated readback')
+    durable(INITIAL, dict(proof, after_etag=etag, authenticated_readback=True))
+    return secure_ref(INITIAL)
