+def secure_ref(path):
+    m = path.lstat()
+    need(stat.S_ISREG(m.st_mode) and m.st_uid == 0 and m.st_nlink == 1
+         and m.st_mode & 0o777 in (0o400, 0o444, 0o600) and path.resolve() == path,
+         'untrusted full 146 evidence: ' + str(path))
+    return bound(path)
+
+
+def sealed_doc(ref):
+    need(secure_ref(Path(ref['path'])) == ref, 'changed full 146 evidence')
+    return checked(ref)
