+    plan = sealed_doc(plan_ref)
+    guard = json.loads(first_bytes)
+    for name in ('permit.json', 'first-guard.json'):
+        m = (state/name).stat()
+        need(m.st_uid == 0 and m.st_nlink == 1 and m.st_mode == stat.S_IFREG | 0o444,
+             'unsealed full 146 release evidence')
+    need(permit == dict(schema='horizon-epoch146-full-producer-permit-v1',
+                        producer_invocation_id=a['producer_invocation_id'],
+                        producer_pid=a['producer_pid'], producer_start_ticks=a['start_ticks'],
+                        worker_ready_unix_seconds=a['worker_ready_unix_seconds'],
+                        prestart_quote_sha256=e['quote']['sha256'], writer_enrollment_sha256=ref['sha256'],
+                        guard_plan_sha256=plan_ref['sha256'],
+                        guard_timer_invocation_id=permit['guard_timer_invocation_id'],
+                        guard_receipt_sha256=hashlib.sha256(first_bytes).hexdigest())
+         and plan['invocation_id'] == a['producer_invocation_id']
+         and all(plan[key] == profile['guard']['properties'][key] for key in
+                 ('unit', 'filesystem', 'worker_root', 'minimum_free_bytes',
+                  'maximum_root_physical_bytes', 'maximum_worker_vmas')),
+         'full 146 release does not bind the enrolled producer and exact protective plan')
+    sample_guard(guard, a, profile, plan_ref, None, a['worker_ready_unix_seconds'])
+    need(guard['recorded_unix_seconds'] <= a['worker_ready_unix_seconds'] + 320,
+         'full 146 release guard falls outside the original launcher hold')
+    return permit, plan_ref, timer(permit['guard_timer_invocation_id'])
