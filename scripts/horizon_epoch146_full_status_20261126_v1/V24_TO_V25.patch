+    e = checked(ref)
+    need(e['schema'] == 'horizon-epoch146-full-status-enrollment-v1' and e['epoch'] == EPOCH
+         and (not prior or prior['enrollment'] == ref), 'different full 146 enrollment')
+    writer = checked(e['writer'])
+    need(e['writer'] == bound(WRITER_REF) and writer['new']['unit'] == CONTROLLER
+         and Path(writer['new']['program']).parent == Path(__file__).resolve().parent,
+         'full 146 enrollment is outside the V25 writer')
+    source = lineage(c, e['fleet'])
+    need('epoch146_bounded_entry_lease' not in source, 'bounded 146 still owns the predecessor')
+    quote = sealed_doc(e['quote'])
+    profile = sealed_doc(e['profile'])
+    hold = checked(dict(path=str(TOOLS/'deployment-seal-receipt.json'), sha256=TOOLS_SEAL))
+    member, = (row for row in hold['members'] if row['name'] == HOLD.name)
+    need(hold['destination'] == str(TOOLS) and member['sha256'] == HOLD_SHA
+         and member['mode'] == '0555' and bound(HOLD)['sha256'] == HOLD_SHA,
+         'different sealed full 146 launcher')
+    guard = quote['pending_guard']
+    need(quote['schema'] == 'horizon-epoch146-full-prestart-fit-v1' and quote['epoch'] == EPOCH
+         and quote['fleet'] == e['fleet'] and quote['fit']['fits'] is True
+         and quote['native_v17_provider_sha256'] == V17_SHA
+         and quote['replay_launch_authorized'] is quote['publication_authorized'] is False
+         and quote['resource_credit_bytes'] == 0 and guard['unit'] == UNIT
+         and guard['worker_root'] == str(RUN) and guard['maximum_root_physical_bytes'] == CAP
+         and guard['producer_cpu_quota_micros'] == 6250000
+         and guard['producer_memory_bytes'] == 68 << 30 and guard['guard_cpu_quota_micros'] == 1000000
+         and guard['guard_memory_bytes'] == 1 << 30 and guard['swap_bytes'] == 0,
+         'different full 146 V17 prestart fit')
+    need(profile['schema'] == 'horizon-epoch146-full-native-guard-and-producer-projection-v1'
+         and profile['epoch'] == EPOCH and profile['prestart_quote_sha256'] == e['quote']['sha256']
+         and profile['guard']['binary']['sha256'] == GUARD_SHA and profile['guard']['timer'] == TIMER
+         and all(profile['guard']['properties'][key] == guard[key] for key in
+                 ('unit', 'filesystem', 'worker_root', 'minimum_free_bytes',
+                  'maximum_root_physical_bytes', 'maximum_worker_vmas'))
+         and profile['source_inputs']['node'] == {'path': str(NODE), 'sha256': NODE_SHA}
+         and profile['source_inputs']['worker']['sha256'] == WORKER_SHA,
+         'different exact full 146 profile')
+    actor = e['actor']
+    need(actor['producer_unit'] == UNIT and re.fullmatch('[0-9a-f]{32}', actor['producer_invocation_id'])
+         and int(actor['producer_invocation_id'], 16) and actor['producer_pid'] > 1
+         and actor['start_ticks'] > 0 and actor['worker_ready_unix_seconds'] >= quote['recorded_unix_seconds']
+         and actor['worker_ready_unix_seconds'] <= quote['recorded_unix_seconds'] + 900
+         and actor['profile_sha256'] == e['profile']['sha256'],
+         'invalid full 146 worker-ready identity')
+    return ref, e, profile
