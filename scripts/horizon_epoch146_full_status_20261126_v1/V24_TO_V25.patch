+def worker_view(proc, pids, e, profile, plan_ref, phase):
+    if len(pids) == 1:
+        return phase, None, None
+    pid, = pids - {int(proc.name)}
+    wp = Path('/proc') / str(pid)
+    wexe = (wp/'exe').readlink()
+    wstat = (wp/'exe').stat()
+    need(wexe.name == 'historical-worker' and wexe.parent.name == 'bound-worker'
+         and wexe.is_relative_to(RUN/'private') and (wp/'cgroup').read_text().strip() == '0::'+GROUP
+         and int((wp/'stat').read_text().rsplit(')', 1)[1].split()[1]) == int(proc.name)
+         and wstat.st_mode & 0o222 == 0 and image_digest(wp/'exe') == WORKER_SHA,
+         'foreign full 146 native worker')
+    worker = dict(pid=pid, start_ticks=ticks(pid), path=str(wexe), device=wstat.st_dev, inode=wstat.st_ino)
+    if not FIRST_WORKER.exists():
+        return phase, worker, None
+    ref = secure_ref(FIRST_WORKER)
+    f = checked(ref)
+    a = e['actor']
+    guard = sealed_doc(f['guard_sample'])
+    need(f['schema'] == 'horizon-epoch146-full-first-protected-worker-v1'
+         and f['enrollment'] == secure_ref(ENROLLMENT) and f['worker'] == worker,
+         'full 146 first-worker evidence changed identity')
+    first = json.loads((proc/'root'/ALIAS.relative_to('/')/'state/first-guard.json').read_bytes())
+    now = guard['recorded_unix_seconds']
+    need(first['recorded_unix_seconds'] <= now <= first['recorded_unix_seconds'] + 1800
+         and guard['guard_invocation_id'] != first['guard_invocation_id'],
+         'full 146 first native worker sample is stale or copied from held state')
+    sample_guard(guard, a, profile, plan_ref, pid, first['recorded_unix_seconds'])
+    return 'worker', worker, ref
