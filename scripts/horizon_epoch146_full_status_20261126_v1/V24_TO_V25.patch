+def lineage(c, predecessor):
+    ref, fleet = c.fleet_ref, c.fleet
+    while ref != predecessor:
+        ref = fleet['previous_Root_operational_review']
+        parent = checked(ref)
+        need(utc(parent['sampled_at_utc']) < utc(fleet['sampled_at_utc']),
+             'full 146 enrollment is outside the accepted cadence lineage')
+        fleet = parent
+    return fleet
