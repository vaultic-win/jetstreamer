+def protection(proc, ref, e, profile):
+    state = proc/'root'/ALIAS.relative_to('/')/'state'
+    permit = json.loads((state/'permit.json').read_bytes())
+    first_bytes = (state/'first-guard.json').read_bytes()
+    a = e['actor']
