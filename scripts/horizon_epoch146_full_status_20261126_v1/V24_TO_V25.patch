+def observe(c, observed_lane):
+    setup = enrollment(c)
+    if setup is None:
+        unit = show(UNIT, DRAIN_FIELDS)
+        need(unit['ActiveState'] in ('inactive', 'failed') and unit['MainPID'] == '0'
+             and not unit['Job'] and not group_pids(UNIT), 'full 146 producer lacks an enrollment')
+        return None
+    ref, e, profile = setup
+    need(c.entry146 is None, 'full 146 conflicts with retained bounded 146')
+    unit = show(UNIT, UNIT_FIELDS)
+    a = e['actor']
+    row = dict(enrollment=ref, unit=unit, actor=a, epoch=EPOCH, observer=c.sample_ref,
+               admission=ref, start_ticks=a['start_ticks'], measured_progress=False,
+               resource_credit_bytes=0, scratch_path=None, observer_config=None)
+    if unit['ActiveState'] in ('inactive', 'failed'):
