+    permit, plan_ref, guard_timer = protection(proc, ref, e, profile)
+    phase, worker, first = worker_view(proc, pids, e, profile, plan_ref, phase)
+    row.update(phase=phase, worker=worker, first_guard=permit['guard_receipt_sha256'],
