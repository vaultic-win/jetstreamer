[Unit]
Description=Verify natural completion of the cold retry4 epoch 168 producer

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
CPUQuota=25%
CPUWeight=10
MemoryMax=128M
MemorySwapMax=0
TasksMax=16
TimeoutStartSec=350
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
ReadWritePaths=/var/lib/jetstreamer/horizon_runtime_data/epoch168-cold-delivery-20261123-v4
ExecStart=/var/lib/jetstreamer/horizon_runtime_data/epoch168-cold-delivery-20261123-v4/terminal-tools/terminal168 wait-record
