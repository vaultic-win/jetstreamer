[Unit]
Description=Verify natural completion of the cold source-index epoch 167 producer

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
CPUQuota=25%
CPUWeight=10
MemoryMax=128M
MemorySwapMax=0
TasksMax=16
TimeoutStartSec=350
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
ReadWritePaths=/var/lib/jetstreamer/horizon_runtime_data/epoch167-cold-delivery-20261122-v3
ExecStart=/var/lib/jetstreamer/horizon_runtime_data/epoch167-cold-delivery-20261122-v3/terminal-tools/terminal167 wait-record
