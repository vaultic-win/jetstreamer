def tree_size(root,cap,exclude=None):
    start=root.stat()
    s.need(root.resolve(strict=True)==root and start.st_dev==HOME.stat().st_dev and root.parent==H,"wrong booking root")
    # GNU du deduplicates hard links without storing a Python object for every shard.
    for line in Path("/proc/self/mountinfo").read_text().splitlines():
        point=Path(line.split()[4])
        s.need(not point.is_relative_to(root),"unexpected mount inside replay tree")
    args=["/usr/bin/du","--summarize","--one-file-system","--block-size=1"]
    if exclude is not None:
        s.need(exclude!=root and exclude.is_relative_to(root) and exclude.resolve(strict=True)==exclude and
               not any(c in str(exclude) for c in "*?[]"),"foreign active exclusion")
        args.append("--exclude="+str(exclude))
    output=subprocess.check_output([*args,"--",root],
                                   text=True,timeout=50)
    amount,path=output.rstrip("\n").split("\t")
    size=int(amount)
    s.need(path==str(root) and 0<size<=cap and os.path.samestat(start,root.stat()),"whole tree exceeds booking")
    return size


class WorkerFork(Exception):
    """The authenticated child exists, but the last completed native sample predates it."""
    def __init__(self,epoch,anchor):
        self.epoch=epoch
        self.anchor=anchor
        super().__init__("waiting for the native guard to observe the worker fork")

class Reprice(Exception):
    def __init__(self,epoch,before,after):
        self.epoch=epoch
        self.before=before
        self.after=after
        super().__init__("confirmed worker fork requires a complete second capacity capture")

def same_fork(before,after,observed):
    for field in ("producer_unit","producer_invocation_id","producer_pid","start_ticks","processes","timer",
                  "timer_invocation_id","plan","first_guard","actor","admission"):
        s.need(before[field]==after[field],"worker fork changed "+field)
    if observed:
        s.need(after["guard"]!=before["guard"] and after["guard_time"]>=before["guard_time"],
               "worker lacks a subsequent completed native guard")

