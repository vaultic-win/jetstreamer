def disk_budget(raw,c136,booking,epoch,peers,replacements):
    # The original aggregate includes a full independent-166 allowance and standard
    # peer allowances measured net of the original, single physical baseline.
    # Charge any newly unfulfilled baseline. Never count closed-file reclamation twice.
    deficit=sum(max(0,x["historical_realized_bytes"]-x["physical_bytes"]) for x in booking.values())
    # Native incumbent floors retain the stopped-era basis. Growth already realized by
    # a newly admitted generation consumes only its own stop-era, prepaid allowance.
    spent=sum(v["prestart_remaining"]-booking[k]["remaining_bytes"] for k,v in replacements.items())
    required=max(raw+deficit-spent,c136.get("guard_floor",0))+c136["remaining"]
    # Each candidate spends its prepaid share of the aggregate, while all other
    # commitments and every incumbent's absolute native trip threshold stay protected.
    allowance=booking.get(str(epoch),{}).get("remaining_bytes",0)
    absolute=max([8297502499408,*[x["guard"]["floor"] for x in peers.values()],
                  *[x["floor"] for k,x in replacements.items() if int(k)!=epoch],c136.get("guard_floor",0)])
    protected=max(required-allowance,absolute)
    return protected+allowance,protected,deficit

