def capture_native(epoch,ref,prestart136=None):
    try:
        return capture_once(epoch,ref,prestart136)
    except WorkerFork as fork:
        e,before=fork.epoch,fork.anchor
        after=confirm_fork(e,epoch,before,{} if FIFTH168 and e==168 else proof_stops()[str(e)])
    except Reprice as confirmed:
        e,before,after=confirmed.epoch,confirmed.before,confirmed.after
    # Discard every earlier resource measurement. A second fork or a change of child
    # fails the capture instead of chaining unbounded retries.
    result=capture_once(epoch,ref,prestart136)
    row=result["candidate"] if e==epoch else result["replacements"].get(str(e))
    s.need(row is not None,"replacement disappeared during complete reprice")
    same_fork(after,row,False)
    s.need(row["guard_time"]>=after["guard_time"] and row["guard"]!=before["guard"],"older guard after full reprice")
    result["confirmed_worker_fork"]=dict(epoch=e,before=before["guard"],first_worker=after["guard"],
                                         final_guard=row["guard"],processes=row["processes"],complete_fit_repeated=True)
    return result

