           f["schema"]=="horizon-Root-complete-fleet-operational-review-v1" and 0<=time.time()-f["recorded_unix_seconds"]<=2400 and
           f["all_existing_memory_DATA_OS_native_transport_promises_retained"] is True and f["all_reservation_ending_bytes"]==0 and
