        exe=Path(f"/proc/{p}/exe");m=exe.stat();par,start,cg=s.process(p)
        s.need(start==tick and (m.st_dev,m.st_ino)==(device,inode) and cg=="0::"+group and (p==pid or par==pid),"native child changed during sampling")
