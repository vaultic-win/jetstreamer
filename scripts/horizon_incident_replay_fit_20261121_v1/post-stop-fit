def census(peers,replacements,extra,c136,own,stops):
    expect={v["unit"]:v["processes"] for v in peers.values()}
    expect.update({v["producer_unit"]:v["processes"] for v in replacements.values()})
    if extra and extra["actor"]:
        a=extra["actor"];expect[s.U]=[(a["producer_pid"],a["start_ticks"])]
        if extra.get("first_worker"):
            w=bound(extra["first_worker"]);expect[s.U].append((w["worker_pid"],w["worker_start_ticks"]))
    if c136["occupied"]:expect[fit.N136]=c136["identity"]["processes"]
    s.need(fit.units()==set(expect),"foreign qualifier unit")
    for u,prs in expect.items():
        members=fit.members(u);expected=tuple(sorted(p[0] for p in prs))
        if members!=expected:
            item=next(((int(k),v) for k,v in replacements.items() if v["producer_unit"]==u),None)
            s.need(item and len(expected)==1 and len(members)==2 and expected[0] in members,"unexpected cgroup processes "+u)
            e,prior=item
            try:
                now=native_actor(e,own,Path(bound(prior["plan"])["worker_root"]),stable_root(e),stops[str(e)])
            except WorkerFork as fork:
                same_fork(dict(prior,processes=fork.anchor["processes"]),fork.anchor,False)
                raise
            s.need(now and len(now["processes"])==2 and now["processes"][:1]==prior["processes"],"changed bootstrap")
            before=dict(prior,processes=now["processes"])
            same_fork(before,now,True)
            raise Reprice(e,before,now)
        for p,ticks,*inode in prs:
            st=Path(f"/proc/{p}/exe").stat()
            s.need(s.process(p)[1:]==(ticks,"0::/system.slice/"+u) and (not inode or [st.st_dev,st.st_ino]==inode),"process generation changed")
    monitored={p[0] for prs in expect.values() for p in prs}
    for p in Path("/proc").iterdir():
        if not p.name.isdigit() or int(p.name) in monitored:continue
        try:comm=(p/"comm").read_text().strip()
        except (FileNotFoundError,ProcessLookupError):continue
        if comm.startswith(("historical-work","jetstreamer-nod")):
            # A child may appear after the cgroup leg. Recheck only the previously
            # attested one-process replacement; any other executable is foreign.
            parent,_,group=s.process(int(p.name))
            item=next(((int(k),v) for k,v in replacements.items() if len(v["processes"])==1 and
                       v["producer_pid"]==parent and group=="0::/system.slice/"+v["producer_unit"]),None)
            s.need(item and comm.startswith("historical-work"),"unregistered replay process "+p.name)
            e,prior=item
            try:
                now=native_actor(e,own,Path(bound(prior["plan"])["worker_root"]),stable_root(e),stops[str(e)])
            except WorkerFork as fork:
                same_fork(dict(prior,processes=fork.anchor["processes"]),fork.anchor,False)
                raise
            s.need(now is not None and len(now["processes"])==2 and now["processes"][1][0]==int(p.name),"unexpected native child")
            before=dict(prior,processes=now["processes"])
            same_fork(before,now,True)
            raise Reprice(e,before,now)
    return {u:[p[:2] for p in prs] for u,prs in expect.items()}

def joined_resident(active):
    if not active["admission"]:return 0
    unit=active["producer_unit"];ps=active["processes"]
    def lower():
        total=0
        for pid,ticks,device,inode in ps:
            p=Path(f"/proc/{pid}")
            st=(p/"exe").stat()
            s.need(s.process(pid)[1:]==(ticks,"0::/system.slice/"+unit) and
                   (st.st_dev,st.st_ino)==(device,inode),"resident owner changed")
            total+=1024*int(next(l.split()[1] for l in (p/"smaps_rollup").read_text().splitlines() if l.startswith("Pss:")))
        mem=dict(l.split() for l in (Path("/sys/fs/cgroup/system.slice")/unit/"memory.stat").read_text().splitlines())
