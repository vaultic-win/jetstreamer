             plan=pref,physical=physical,prestart_remaining=pre["bookings"][str(e)]["remaining_bytes"],
             timer=timer,timer_invocation_id=timerrow["InvocationID"],processes=processes,floor=plan["minimum_free_bytes"])
    if actual!=guarded:
        s.need(len(actual)==1 and guarded==[] and fit.members(unit)==ps,"foreign worker or disappearing child")
        raise WorkerFork(e,row)
    return row

def confirm_fork(epoch,own,baseline,stop):
    plan=bound(baseline["plan"]);tree=Path(plan["worker_root"]);run=stable_root(epoch)
    deadline=time.monotonic()+55
    while True:
        try:
            current=native_actor(epoch,own,tree,run,stop)
            s.need(current is not None and len(current["processes"])==2,"expected child disappeared")
            same_fork(baseline,current,True)
            return current
        except WorkerFork as exc:
            same_fork(baseline,exc.anchor,False)
        s.need(time.monotonic()<deadline,"guard did not capture expected child")
        time.sleep(.6)


