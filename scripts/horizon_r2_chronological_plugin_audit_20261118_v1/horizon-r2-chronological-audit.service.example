[Unit]
Description=Chronological read-only audit of canonical Horizon R2 archives
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=sol
Group=sol
UMask=0077
# Replace both paths with the parent-reviewed Rust-sealed deployment paths.
ExecStart=/SEALED/horizon-r2-chronological-plugin-audit run /SEALED/config.json
EnvironmentFile=/etc/jetstreamer/horizon-r2-audit.env
WorkingDirectory=/var/lib/jetstreamer/r2-chronological-plugin-audit-20261118-v1
Restart=on-failure
RestartSec=1800
KillMode=control-group
TimeoutStopSec=60
SendSIGKILL=yes
Nice=10
CPUWeight=25
IOWeight=25
CPUQuota=400%
MemoryMax=16G
MemorySwapMax=0
TasksMax=1024
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/jetstreamer/r2-chronological-plugin-audit-20261118-v1 /home/sol/.cargo /usr/local/lib/jetstreamer/horizon-r2-audit-readers-20261118-v1

[Install]
WantedBy=multi-user.target
