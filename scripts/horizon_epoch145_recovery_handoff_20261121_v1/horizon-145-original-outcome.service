[Unit]
Description=Dispatch the original epoch 145 verifier's observed outcome
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
CPUQuota=25%
CPUWeight=10
Nice=15
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
UMask=0077
EnvironmentFile=/etc/jetstreamer/horizon-r2.env
ExecStart=/var/lib/jetstreamer/horizon_runtime_data/epoch145-recovery-handoff-20261121-v1/outcome-tools/follow145 route-outcome
