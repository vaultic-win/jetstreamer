[Unit]
Description=Verify Anza's private epoch 168 archive after its assembler closes
After=network-online.target
RequiresMountsFor=/var/lib/jetstreamer/horizon_runtime_data/epoch168-exact-private-verification-20261127-v1 /home/sol/.jetstreamer-private/epoch168-private-assembly-20261127-v1
ConditionPathExists=/var/lib/jetstreamer/horizon_runtime_data/epoch168-exact-private-verification-20261127-v1/deployment.json
ConditionPathExists=!/var/lib/jetstreamer/horizon_runtime_data/epoch168-exact-private-verification-20261127-v1/ACCEPTED.json

[Service]
Type=exec
ExecStart=/usr/bin/python3 -IB /var/lib/jetstreamer/horizon_runtime_data/epoch168-exact-private-verification-20261127-v1/tools-v1/dispatch.py watch
Restart=on-failure
RestartSec=60
MemoryMax=128M
MemorySwapMax=0
CPUQuota=50%
CPUQuotaPeriodSec=100ms
TasksMax=64
Nice=12
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/jetstreamer/horizon_runtime_data/epoch168-exact-private-verification-20261127-v1 /home/sol/workspace/jetstreamer/.git

[Install]
WantedBy=multi-user.target
