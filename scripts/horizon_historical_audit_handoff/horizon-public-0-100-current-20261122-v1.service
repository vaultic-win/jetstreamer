[Unit]
Description=Re-verify Horizon epochs 0 through 100 after the ready 101–300 audit releases its readers
After=local-fs.target network-online.target horizon-ready-output-mounts-20261121-v1.service
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=exec
Slice=horizonaudit.slice
ExecCondition=/usr/bin/python3 -IB /var/lib/jetstreamer/horizon_runtime_data/historical-ready-handoff-20261122-v2/history.py ready
ExecStart=/usr/bin/python3 -IB /var/lib/jetstreamer/horizon_runtime_data/historical-ready-handoff-20261122-v2/history.py play
CPUWeight=10
CPUQuota=400%
MemoryHigh=14G
MemoryMax=16G
MemorySwapMax=0
TasksMax=448
LimitMEMLOCK=128M
KillMode=control-group
Restart=no
RestartForceExitStatus=75
RestartSec=90
TimeoutStopSec=20
UMask=0077
