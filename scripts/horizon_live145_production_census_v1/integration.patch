+#[cfg(test)] mod production_census_tests {
+ use super::*;
+ #[test]
+ #[ignore = "Root-only readonly production census for exact live145 actor/guard/timer"]
+ fn actual_production_unit_census_accepts_complete_live145_family_and_authenticates_it() {
+  let mut raw=NativeCensus::new();
+  for role in contract::FAMILY { raw.insert(role.to_owned(),crate::fleet::unit(role).unwrap()); }
+  let plan=serde_json::json!({"tracked_units":contract::FAMILY});
+  let (proof,projected)=capture_native(&plan,&raw).unwrap();
+  assert!(proof.is_some());assert!(projected.is_empty());
+  assert_eq!(raw.len(),3);assert!(raw.contains_key(contract::FAMILY[2]));
+  println!("{}",serde_json::json!({"raw_production_census":raw,"authenticated_live145":proof,"archive_body_reads":false,"replay_admission_authorized":false,"memory_or_DATA_credit_bytes":0}));
+ }
